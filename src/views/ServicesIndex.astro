---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import IndexHero from '../components/IndexHero.astro';
import ProcessStory from '../components/ProcessStory.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
import { localName, localePath, t, type Lang } from '../i18n/ui';
import { consultancyCopy, inEnglish, serviceHighlights, serviceShorts } from '../i18n/content';

import bioImg from '../assets/photos/biomining-trommel-site.jpg';
import mswImg from '../assets/photos/plant-line-wide.jpg';
import mrfImg from '../assets/photos/mrf-sorting-floor.jpg';
import rdfImg from '../assets/photos/shredder-ads-line.jpg';
import heroA from '../assets/photos/biomining-excavator.jpg';
import heroB from '../assets/photos/sorting-conveyor.jpg';
import heroC from '../assets/photos/hero-plant-shed.jpg';
import consImg from '../assets/photos/plant-layout-render.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const images: Record<string, ImageMetadata> = {
  'bio-mining-and-legacy-waste-management': bioImg,
  'msw-processing-plant': mswImg,
  'material-recovery-facility-mrf-plant': mrfImg,
  'rdf-afr-plant': rdfImg,
};


const copy = {
  en: {
    title: 'Services | Bio-mining, MSW, MRF & RDF/AFR Plants',
    description:
      'Turnkey waste-processing plants from Hind Zero Waste: bio-mining of legacy waste, MSW processing, material recovery facilities and RDF/AFR plants, designed, built, commissioned and operated.',
    eyebrow: 'Services',
    heroTitle: 'Turnkey plants, <em>end to end</em>.',
    lead: 'We design, manufacture, install, commission and operate complete waste-processing plants, and take responsibility for their performance from the first survey to daily operation.',
    stats: ['Plant types', 'Bio-mining projects', 'Years of O&M contracted'],
    browse: 'See our services',
    listEyebrow: 'Our services',
    listTitle: 'Four plants, <em>one partner</em>',
    explore: 'Explore',
    discuss: 'Discuss your project',
    consEyebrow: 'Consultancy',
    apprEyebrow: 'How we work',
    apprTitle: 'One partner, from drawing board to <em>daily operation</em>.',
    apprIntro: 'One team is accountable from the first site survey to everyday operation of the plant.',
    crumbs: ['Home', 'Services'],
  },
  hi: {
    title: 'सेवाएँ | बायो-माइनिंग, MSW, MRF और RDF/AFR प्लांट',
    description:
      'हिंद ज़ीरो वेस्ट के टर्नकी कचरा प्रसंस्करण प्लांट: पुराने कचरे का बायो-माइनिंग, MSW प्रसंस्करण, मटेरियल रिकवरी फ़ैसिलिटी और RDF/AFR प्लांट।',
    eyebrow: 'सेवाएँ',
    heroTitle: 'शुरुआत से अंत तक, <em>टर्नकी</em> प्लांट।',
    lead: 'हम पूर्ण कचरा प्रसंस्करण प्लांट का डिज़ाइन, निर्माण, स्थापना, कमीशनिंग और संचालन करते हैं, और पहले सर्वेक्षण से लेकर दैनिक संचालन तक उनके प्रदर्शन की ज़िम्मेदारी लेते हैं।',
    stats: ['प्लांट के प्रकार', 'बायो-माइनिंग परियोजनाएँ', 'वर्ष का O&M अनुबंध'],
    browse: 'हमारी सेवाएँ देखें',
    listEyebrow: 'हमारी सेवाएँ',
    listTitle: 'चार प्लांट, <em>एक साझेदार</em>',
    explore: 'विस्तार से देखें',
    discuss: 'अपनी परियोजना पर बात करें',
    consEyebrow: 'परामर्श',
    apprEyebrow: 'हमारी कार्यप्रणाली',
    apprTitle: 'डिज़ाइन से <em>दैनिक संचालन</em> तक, एक ही साझेदार।',
    apprIntro: 'पहले साइट सर्वेक्षण से लेकर प्लांट के रोज़मर्रा के संचालन तक, एक ही टीम ज़िम्मेदार।',
    crumbs: ['होम', 'सेवाएँ'],
  },
  mr: {
    title: 'सेवा | बायो-मायनिंग, MSW, MRF व RDF/AFR प्लांट',
    description:
      'हिंद झिरो वेस्टचे टर्नकी कचरा प्रक्रिया प्लांट: जुन्या कचऱ्याचे बायो-मायनिंग, MSW प्रक्रिया, मटेरियल रिकव्हरी फॅसिलिटी आणि RDF/AFR प्लांट.',
    eyebrow: 'सेवा',
    heroTitle: 'सुरुवातीपासून शेवटपर्यंत, <em>टर्नकी</em> प्लांट.',
    lead: 'आम्ही संपूर्ण कचरा प्रक्रिया प्लांटचे डिझाइन, निर्मिती, उभारणी, कमिशनिंग आणि संचालन करतो, आणि पहिल्या सर्वेक्षणापासून दैनंदिन संचालनापर्यंत त्यांच्या कामगिरीची जबाबदारी घेतो.',
    stats: ['प्लांटचे प्रकार', 'बायो-मायनिंग प्रकल्प', 'वर्षांचे O&M करार'],
    browse: 'आमच्या सेवा पाहा',
    listEyebrow: 'आमच्या सेवा',
    listTitle: 'चार प्लांट, <em>एक भागीदार</em>',
    explore: 'सविस्तर पाहा',
    discuss: 'तुमच्या प्रकल्पाबद्दल बोला',
    consEyebrow: 'सल्ला',
    apprEyebrow: 'आमची कार्यपद्धती',
    apprTitle: 'डिझाइनपासून <em>दैनंदिन संचालनापर्यंत</em>, एकच भागीदार.',
    apprIntro: 'पहिल्या साइट सर्वेक्षणापासून प्लांटच्या दैनंदिन संचालनापर्यंत, एकच टीम जबाबदार.',
    crumbs: ['होम', 'सेवा'],
  },
}[lang];

const home = lang === 'en' ? '/' : `/${lang}/`;
const alternates = { en: '/services', hi: '/hi/services', mr: '/mr/services' };
const contact = localePath(lang, '/contact-us');
---

<Base title={copy.title} description={copy.description} lang={lang} alternates={alternates}>
  <IndexHero
    tone="olive"
    eyebrow={copy.eyebrow}
    title={copy.heroTitle}
    lead={copy.lead}
    crumbs={[{ label: copy.crumbs[0], href: home }, { label: copy.crumbs[1] }]}
    images={[
      { src: heroA, alt: 'Excavator feeding legacy waste to a screening conveyor' },
      { src: heroB, alt: 'Workers recovering recyclables on a sorting conveyor' },
      { src: heroC, alt: 'Segregation and RDF line in a steel shed' },
    ]}
    stats={[
      { value: services.length, label: copy.stats[0] },
      { value: 87, suffix: '+', label: copy.stats[1] },
      { value: 30, label: copy.stats[2] },
    ]}
  >
    <a class="btn btn--accent" href="#plants">{copy.browse} <span class="arrow">↓</span></a>
    <a class="btn btn--ghost" href={`${contact}#enquiry`}>{t(lang, 'cta.quote')} <span class="arrow">→</span></a>
  </IndexHero>

  <section class="section bg-paper" id="plants">
    <div class="container">
      <div class="cat-head" data-reveal>
        <div>
          <p class="eyebrow">{copy.listEyebrow}</p>
          <h2 class="h2" set:html={copy.listTitle} />
        </div>

      </div>

      <div class="chapters">
        {
          services.map((s, i) => (
            <article class:list={['chapter', { 'chapter--flip': i % 2 === 1 }]} data-reveal>
              <a class="chapter__media" href={`/${s.slug}`} tabindex="-1" aria-hidden="true">
                <Image src={images[s.slug]} alt="" widths={[600, 900, 1280]} sizes="(min-width: 900px) 55vw, 92vw" loading="lazy" />
                <span class="chapter__no tabular">{String(i + 1).padStart(2, '0')}</span>
              </a>
              <div class="chapter__body">
                <p class="chapter__kicker">
                  <span class="tabular">{String(i + 1).padStart(2, '0')} / {String(services.length).padStart(2, '0')}</span>
                  <span class="chip tabular">{s.range}</span>
                </p>
                <h3 class="chapter__title">{localName(lang, s.slug, s.name)}</h3>
                <p class="chapter__lead">{serviceShorts[lang][s.slug]}</p>
                <ul class="chapter__points">
                  {serviceHighlights[lang][s.slug].map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
                <div class="btn-row">
                  <a class="btn btn--accent" href={`/${s.slug}`}>
                    {copy.explore} {inEnglish[lang]} <span class="arrow">→</span>
                  </a>
                  <a class="link-arrow" href={`${contact}?subject=${encodeURIComponent(s.name)}#enquiry`}>
                    {copy.discuss} <span class="arrow">→</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section--tight bg-mineral" id="consultancy">
    <div class="container cons" data-reveal>
      <div class="cons__media"><Image src={consImg} alt="Plant layout drawing for an integrated waste-processing facility" widths={[480, 800]} sizes="(min-width: 900px) 40vw, 92vw" loading="lazy" /></div>
      <div class="cons__body">
        <p class="eyebrow">{copy.consEyebrow}</p>
        <h2 class="h3">{consultancyCopy[lang].name}</h2>
        <p class="muted">{consultancyCopy[lang].text}</p>
      </div>
      <a class="btn btn--accent" href={`${contact}#enquiry`}>{t(lang, 'cta.quote')} <span class="arrow">→</span></a>
    </div>
  </section>

  <ProcessStory lang={lang} eyebrow={copy.apprEyebrow} title={copy.apprTitle} intro={copy.apprIntro} />

  <CtaBand lang={lang} />
</Base>

<style>
  .cat-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 36px;
  }

  .cat-head .h2 {
    margin-top: 14px;
  }

  .svc-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--sky);
    color: var(--navy);
  }

  details[open] .svc-icon {
    background: var(--saffron);
    color: var(--white);
  }

  .svc-panel {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 32px 48px;
    align-items: center;
  }

  .svc-panel__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 12px;
  }

  .svc-panel__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .svc-panel__media:hover :global(img) {
    transform: scale(1.06);
  }

  .svc-panel__body {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .svc-panel__points {
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .svc-panel__points li {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 17px;
    font-weight: 500;
    color: var(--ink);
  }

  .svc-panel__points li::before {
    content: '';
    width: 9px;
    height: 9px;
    margin-top: 0.55em;
    border-radius: 2px;
    background: var(--green);
    flex: none;
  }

  .cons {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) auto;
    gap: 28px 48px;
    align-items: center;
  }

  .cons__icon {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: rgba(200, 100, 59, 0.16);
    color: var(--saffron-2);
  }

  .cons__media {
    overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: 16 / 9;
    box-shadow: var(--shadow-md);
  }

  .cons__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cons__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (max-width: 900px) {
    .svc-panel,
    .cons {
      grid-template-columns: minmax(0, 1fr);
    }

    .cons__icon {
      display: none;
    }
  }
  /* Four plants as alternating chapters: a large photo that opens up as it
     scrolls in, and the story beside it. */
  .chapters {
    display: grid;
    gap: clamp(64px, 9vw, 128px);
  }

  .chapter {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }

  .chapter--flip {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }

  .chapter--flip .chapter__media {
    order: 2;
  }

  .chapter__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 6px;
    box-shadow: 0 40px 80px -50px rgba(var(--shade), 0.6);
  }

  .chapter__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .chapter__media:hover :global(img) {
    transform: scale(1.04);
  }

  .chapter__no {
    position: absolute;
    left: 22px;
    bottom: 6px;
    font: 400 clamp(5rem, 9vw, 8.5rem) / 1 var(--serif);
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.9);
    text-shadow: 0 6px 40px rgba(0, 0, 0, 0.35);
  }

  .chapter--flip .chapter__no {
    left: auto;
    right: 22px;
  }

  .chapter__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .chapter__kicker {
    display: flex;
    align-items: center;
    gap: 14px;
    font: 700 12px/1 var(--sans);
    letter-spacing: 0.18em;
    color: var(--saffron-ink);
  }

  .chapter__kicker .chip {
    letter-spacing: 0;
  }

  .chapter__title {
    font: 400 clamp(2.2rem, 3.6vw, 3.3rem) / 1.04 var(--serif);
    color: var(--ink);
  }

  .chapter__lead {
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
  }

  .chapter__points {
    display: grid;
    width: 100%;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .chapter__points li {
    position: relative;
    padding: 13px 0 13px 28px;
    border-bottom: 1px solid var(--line);
    font-weight: 550;
    color: var(--ink);
  }

  .chapter__points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 50%;
    width: 12px;
    height: 2px;
    background: var(--saffron);
  }

  .chapter .btn-row {
    margin-top: 6px;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .chapter__media {
      clip-path: inset(10% 10% 10% 10% round 6px);
      transition: clip-path 1.2s var(--ease-out);
    }

    :global(.js) .chapter__media :global(img) {
      transform: scale(1.18);
      transition: transform 1.6s var(--ease-out);
    }

    :global(.js) .chapter.is-visible .chapter__media {
      clip-path: inset(0 0 0 0 round 6px);
    }

    :global(.js) .chapter.is-visible .chapter__media :global(img) {
      transform: none;
    }

    .chapter__points li {
      opacity: 0;
      transform: translateX(-12px);
      transition:
        opacity 0.6s var(--ease-out),
        transform 0.6s var(--ease-out);
    }

    .chapter.is-visible .chapter__points li {
      opacity: 1;
      transform: none;
    }

    .chapter.is-visible .chapter__points li:nth-child(2) {
      transition-delay: 0.1s;
    }

    .chapter.is-visible .chapter__points li:nth-child(3) {
      transition-delay: 0.2s;
    }
  }

  @media (max-width: 900px) {
    .chapter,
    .chapter--flip {
      grid-template-columns: minmax(0, 1fr);
    }

    .chapter--flip .chapter__media {
      order: 0;
    }
  }
</style>
