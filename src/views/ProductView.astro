---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import SpecTable from '../components/SpecTable.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import ProductCard from '../components/ProductCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { productBySlug, type Product } from '../data/products';
import { site } from '../data/site';

interface Props {
  product: Product;
}

const { product: p } = Astro.props;
const related = p.related.map(productBySlug).filter((x): x is Product => Boolean(x));
const quoteHref = `/contact-us?subject=${encodeURIComponent(p.name)}#enquiry`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    description: p.seoDescription,
    category: p.category,
    brand: { '@type': 'Brand', name: site.shortName },
    manufacturer: { '@type': 'Organization', name: site.name, url: site.url },
    image: new URL(p.images[0].src.src, Astro.site).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Machinery', item: site.url + '/product' },
      { '@type': 'ListItem', position: 3, name: p.name, item: `${site.url}/${p.slug}` },
    ],
  },
];
---

<Base title={p.seoTitle} description={p.seoDescription} schema={schema}>
  <section class="p-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/product">Machinery</a></li>
          <li><span aria-current="page">{p.name}</span></li>
        </ol>
      </nav>
      <div class="p-hero__grid">
        <div class="p-hero__text">
          <p class="eyebrow">{p.category}</p>
          <h1 class="h1 p-hero__title">{p.name}</h1>
          <p class="lead">{p.lead}</p>
          <dl class="facts">
            <div>
              <dt>Range</dt>
              <dd>{p.range}</dd>
            </div>
            {
              p.table && (
                <div>
                  <dt>Standard models</dt>
                  <dd>{p.table.rows.length}</dd>
                </div>
              )
            }
            <div>
              <dt>Built by</dt>
              <dd>Hind Zero Waste, Kolhapur</dd>
            </div>
          </dl>
          <div class="btn-row">
            <a class="btn" href={quoteHref}>Request a quote <span class="arrow">→</span></a>
            <a class="link-arrow" href={site.downloads.brochure} target="_blank" rel="noopener"
              >Download brochure <span class="arrow">↗</span></a
            >
          </div>
        </div>
        <div class="p-hero__media">
          <Gallery images={p.images} priority />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container two-col" data-reveal>
      <div>
        <p class="eyebrow">Overview</p>
        <h2 class="h3 two-col__title">{p.short}</h2>
      </div>
      <div class="prose">
        {p.overview.map((para) => <p>{para}</p>)}
      </div>
    </div>

    {
      p.variants && (
        <div class="container variants-wrap" data-reveal>
          <h3 class="label">{p.variantsTitle ?? 'Variants'}</h3>
          <ul class:list={['variants', { 'variants--few': p.variants.length <= 2 }]}>
            {p.variants.map((v) => (
              <li>
                <p class="variants__title">{v.title}</p>
                <p class="muted">{v.text}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="eyebrow">Features</p>
          <h2 class="h2">Engineered for <em>continuous duty</em>.</h2>
        </div>
        <p class="muted">
          Designed, fabricated and tested by our own team, then configured to your waste, throughput and site.
        </p>
      </div>
      <ol class="features">
        {
          p.features.map((f, i) => (
            <li data-reveal>
              <span class="features__num tabular">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h4">{f.title}</h3>
              <p class="muted">{f.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    p.steps && (
      <section class="section bg-ink on-dark">
        <div class="container">
          <div class="section-head" data-reveal>
            <p class="eyebrow">Process</p>
            <h2 class="h2">{p.stepsTitle ?? 'How it works'}</h2>
          </div>
          <ol class:list={['steps', { 'steps--many': p.steps.length > 4 }]}>
            {p.steps.map((s, i) => (
              <li data-reveal>
                <span class="steps__num tabular">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="h4">{s.title}</h3>
                <p class="muted">{s.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <section class="section bg-white">
    <div class="container apps" data-reveal>
      <div>
        <p class="eyebrow">Applications</p>
        <h2 class="h2 two-col__title">Where it <em>works</em></h2>
      </div>
      <ul class="apps__list">
        {p.applications.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </section>

  {
    (p.table || p.specs) && (
      <section class="section" id="specifications">
        <div class="container">
          <div class="section-head section-head--split" data-reveal>
            <div>
              <p class="eyebrow">Technical data</p>
              <h2 class="h2">Specifications</h2>
            </div>
            <p class="muted">
              Standard configurations are listed below. We tailor every machine to the material, throughput and plant layout.
            </p>
          </div>
          {p.specs && (
            <dl class="specs" data-reveal>
              {p.specs.map((s) => (
                <div>
                  <dt>{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))}
            </dl>
          )}
          {p.table && (
            <div class="table-wrap" data-reveal>
              <SpecTable table={p.table} caption={`${p.name} models`} />
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    p.video && (
      <section class="section bg-white">
        <div class="container" data-reveal>
          <div class="section-head">
            <p class="eyebrow">In operation</p>
            <h2 class="h2">See it at work</h2>
          </div>
          <VideoEmbed id={p.video.id} title={p.video.title} poster={p.images[1]?.src ?? p.images[0].src} />
        </div>
      </section>
    )
  }

  <section class="section bg-paper-2">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="eyebrow">Related machinery</p>
          <h2 class="h2">Works well <em>alongside</em></h2>
        </div>
        <div>
          <a class="link-arrow" href="/product">View all machinery <span class="arrow">→</span></a>
        </div>
      </div>
      <ul class="related">
        {
          related.map((r) => (
            <li data-reveal>
              <ProductCard product={r} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    title="Talk to our engineers about your <em>requirement</em>."
    text="Share your waste type, tonnage and site details. We will recommend a configuration and prepare a quotation."
    subject={p.name}
  />
</Base>

<style>
  .p-hero {
    padding-block: clamp(32px, 5vw, 64px) clamp(64px, 8vw, 112px);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin-bottom: clamp(28px, 4vw, 48px);
    font-size: 13px;
    color: var(--muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 6px;
    color: var(--line-strong);
  }

  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .p-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 48px 72px;
    align-items: start;
  }

  .p-hero__text {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .p-hero__title {
    margin-top: -8px;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }

  .facts div {
    padding: 16px 16px 0 0;
  }

  .facts div + div {
    padding-left: 16px;
    border-left: 1px solid var(--line);
  }

  .facts dt {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .facts dd {
    margin: 6px 0 0;
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .two-col,
  .apps {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px 72px;
  }

  .two-col__title {
    margin-top: 18px;
  }

  .prose p:first-child {
    font-size: 1.15rem;
    color: var(--ink);
  }

  .variants-wrap {
    margin-top: clamp(56px, 7vw, 96px);
  }

  .label {
    font: 600 12px/1 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 20px;
  }

  .variants {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .variants--few {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .variants li {
    padding: 24px 24px 8px 0;
  }

  .variants li + li {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .variants__title {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    line-height: 1.1;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .features li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 32px 32px 40px 0;
    border-bottom: 1px solid var(--line);
  }

  .features li:not(:nth-child(3n + 1)) {
    padding-left: 32px;
    border-left: 1px solid var(--line);
  }

  .features__num {
    font-family: var(--serif);
    font-size: 1.4rem;
    color: var(--navy);
    margin-bottom: 8px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps--many {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .steps li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 28px 40px 0;
    border-top: 1px solid var(--line-on-dark);
  }

  .steps__num {
    font-family: var(--serif);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--lime);
    margin-bottom: 10px;
  }

  .apps__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
    align-self: start;
  }

  .apps__list li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 16px 18px 0;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
    color: var(--ink);
  }

  .apps__list li::before {
    content: '';
    width: 7px;
    height: 7px;
    background: var(--green);
    flex: none;
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 56px;
    margin: 0 0 clamp(48px, 6vw, 72px);
    border-top: 1px solid var(--ink);
  }

  .specs div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }

  .specs dt {
    color: var(--muted);
  }

  .specs dd {
    margin: 0;
    color: var(--ink);
  }

  .related {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    list-style: none;
  }

  @media (max-width: 1000px) {
    .p-hero__grid,
    .two-col,
    .apps {
      grid-template-columns: minmax(0, 1fr);
    }

    .p-hero__media {
      order: -1;
    }

    .variants {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .variants li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .features,
    .steps,
    .steps--many {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .features li:not(:nth-child(3n + 1)) {
      padding-left: 0;
      border-left: 0;
    }

    .features li:nth-child(even) {
      padding-left: 28px;
      border-left: 1px solid var(--line);
    }

    .specs {
      grid-template-columns: minmax(0, 1fr);
    }

    .related {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .facts {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .facts div:nth-child(3) {
      grid-column: 1 / -1;
      padding-left: 0;
      border-left: 0;
    }

    .variants,
    .variants--few,
    .features,
    .steps,
    .steps--many,
    .apps__list,
    .related {
      grid-template-columns: minmax(0, 1fr);
    }

    .variants li + li,
    .features li:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }

    .variants li {
      border-bottom: 1px solid var(--line);
    }
  }
</style>
