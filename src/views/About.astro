    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--saffron-2) !important;
    margin-bottom: 20px;
  }

  .vmv__list {
    list-style: none;
    counter-reset: m;
  }

  .vmv__list li {
    counter-increment: m;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    padding: 13px 0;
    border-bottom: 1px solid var(--line-on-dark);
    color: #e2d9cf;
  }

  .vmv__list li::before {
    content: counter(m, decimal-leading-zero);
    font-weight: 800;
    color: var(--lime);
  }

  .vmv__values {
    color: #e2d9cf;
    font-size: 1.15rem;
    line-height: 1.7;
  }

  /* Why us */
  .why__eyebrow {
    font-size: clamp(16px, 1.4vw, 19px);
  }

  .why__eyebrow::before {
    width: 11px;
    height: 11px;
    box-shadow: 0 13px 0 var(--green);
    transform: translateY(-6px);
  }

  .why__title {
    font-size: clamp(2.6rem, 4.8vw, 4.4rem);
  }

  .why {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    list-style: none;
  }

  .why__card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 30px 26px;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.6);
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.5s var(--ease-out),
      border-color 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
  }

  .why__icon {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    margin-bottom: 6px;
    border-radius: 16px;
    background: var(--navy);
    color: var(--white);
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease),
      transform 0.45s var(--ease-out);
  }

  .why__card {
    border: 2px solid transparent;
  }

  .why__card:hover,
  .why__card.is-lit {
    transform: translateY(-10px) scale(1.03);
