<script>
  // "Why clients choose us": the spotlight moves from card to card so each point
  // gets a moment of attention. It pauses while the visitor points at a card.
  const why = document.querySelector<HTMLElement>('[data-spotlight]');
  if (why) {
    const cards = [...why.querySelectorAll<HTMLElement>('.why__card')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;
    const light = (n: number) => {
      current = n % cards.length;
      cards.forEach((c, i) => c.classList.toggle('is-lit', i === current));
    };
    const start = () => {
      window.clearInterval(timer);
      if (!reduce) timer = window.setInterval(() => light(current + 1), 2600);
    };
    cards.forEach((card, i) => {
      card.addEventListener('mouseenter', () => {
        window.clearInterval(timer);
        light(i);
      });
      card.addEventListener('mouseleave', start);
    });
    // Only cycle while the section is on screen.
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : window.clearInterval(timer)), {
      threshold: 0.3,
    }).observe(why);
  }
</script>

<style>
  /* Story */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 48px 72px;
    align-items: center;
  }

  .story__title {
    margin: 16px 0 28px;
  }

  .story__body {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .story__media {
    position: relative;
    aspect-ratio: 4 / 4.4;
    border-radius: var(--radius-lg);
    overflow: visible;
  }

  .story__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .story__badge {
    position: absolute;
    left: -28px;
    bottom: 36px;
    display: flex;
    flex-direction: column;
    padding: 20px 24px;
    border-radius: 12px;
    background: var(--saffron);
    color: var(--white);
    box-shadow: var(--shadow-md);
    animation: bob 5s ease-in-out infinite alternate;
  }

  .story__badge strong {
    font: 800 2.4rem/1 var(--sans);
    letter-spacing: -0.03em;
  }

  .story__badge span {
    font-weight: 650;
    font-size: 15px;
  }

  @keyframes bob {
    to {
      transform: translateY(-10px);
    }
  }

  /* Projects */
  .proj {
    position: relative;
    overflow: hidden;
  }

  .proj::before {
    content: '';
    position: absolute;
    inset: -20% auto auto -15%;
    width: 60vw;
    height: 60vw;
    background: radial-gradient(circle, rgba(200, 100, 59, 0.35), transparent 60%);
    pointer-events: none;
  }

  .proj .container {
    position: relative;
  }

  .proj__intro {
    font-size: 17px;
  }

  .proj__title {
    font-size: clamp(2.6rem, 5vw, 4.6rem);
  }

  .proj__record {
    margin-top: clamp(64px, 8vw, 104px);
  }

  .pstats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 0;
  }

  .pstats__item {
    padding: 30px 30px 28px;
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, rgba(246, 243, 236, 0.07), rgba(246, 243, 236, 0.02));
    border: 1px solid var(--line-on-dark);
    transition:
      transform 0.45s var(--ease-out),
      border-color 0.45s var(--ease-out),
      background-color 0.45s var(--ease-out);
  }

  .pstats__item:hover {
    transform: translateY(-6px) scale(1.02);
    border-color: var(--saffron);
  }

  .pstats__item dt {
    font: 800 clamp(2.6rem, 4.4vw, 4rem) / 1 var(--sans);
    letter-spacing: -0.04em;
    color: var(--saffron-2);
  }

  .pstats__item:first-child dt {
    color: var(--lime);
  }

  .pstats__item dd {
    margin: 12px 0 0;
    font-size: 16px;
    color: #d4c9bc;
    max-width: 22em;
  }

  /* Installed base */
  .states-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    list-style: none;
  }

  .state {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px 24px 26px;
    border-radius: var(--radius-lg);
    background: var(--white);
    border-top: 4px solid var(--navy);
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out),
      border-color 0.45s var(--ease-out);
  }

  .state:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
    border-color: var(--saffron);
  }

  .state--supply {
    border-top-color: var(--green);
  }

  .state__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .state__title {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .state :global(.state__mark) {
    flex: none;
    width: 92px;
    height: auto;
    margin: -6px -6px 0 0;
    color: var(--saffron);
    opacity: 0.55;
    transition:
      opacity 0.4s var(--ease),
      transform 0.5s var(--ease-out);
  }

  .state:hover :global(.state__mark) {
    opacity: 1;
    transform: scale(1.06);
  }

  .state__name {
    font-family: var(--serif);
    font-size: 1.8rem;
    line-height: 1.1;
