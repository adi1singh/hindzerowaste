  .state__sites {
    list-style: none;
    display: grid;
    gap: 7px;
    font-size: 15px;
    color: var(--muted);
  }

  /* Vision, mission, values */
  .vmv__quote {
    margin-top: 24px;
    font-family: var(--serif);
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    line-height: 1.18;
    color: var(--paper);
    max-width: 22em;
  }

  .vmv__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 72px;
    margin-top: clamp(48px, 6vw, 80px);
