const posts = lang === 'en' ? (await getCollection('blog')).sort((a, b) => a.data.order - b.data.order).slice(0, 3) : [];
const alternates = { en: '/', hi: '/hi/', mr: '/mr/' };
---

<Base title={copy.title} description={copy.description} lang={lang} alternates={alternates}>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero__top">
        <div>
          <p class="eyebrow">{copy.heroEyebrow}</p>
          <h1 class="display hero__title" set:html={copy.heroTitle} />
        </div>
        <div class="hero__aside">
          <p class="lead">{copy.heroLead}</p>
          <div class="btn-row">
            <a class="btn" href={localePath(lang, '/contact-us') + '#enquiry'}>{t(lang, 'cta.quote')} <span class="arrow">→</span></a>
            <a class="link-arrow" href="/product">{t(lang, 'cta.explore')} <span class="arrow">→</span></a>
          </div>
        </div>
      </div>
      <figure class="hero__figure">
        <div class="frame hero__frame">
          <Image
            src={heroImage}
            alt="Conveyors, separators and a shredder line inside a large steel processing shed"
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 1320px) 1240px, 94vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="caption">{copy.heroCaption}</figcaption>
      </figure>
      <dl class="figures">
        {
          figures.map((f, i) => (
            <div class="figures__item">
              <dt class="figures__value tabular">{f.value}</dt>
              <dd class="figures__label">{copy.figures[i]}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="section bg-white">
    <div class="container phil" data-reveal>
      <div>
        <p class="eyebrow">{copy.philEyebrow}</p>
        <h2 class="h1 phil__title" set:html={copy.philTitle} />
      </div>
      <div class="phil__body">
        {copy.philParas.map((p, i) => <p class={i === 0 ? 'lead' : 'muted'}>{p}</p>)}
        <a class="link-arrow" href={localePath(lang, '/about-us')}>{copy.philLink} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="eyebrow">{copy.svcEyebrow}</p>
          <h2 class="h2" set:html={copy.svcTitle} />
        </div>
        <p class="muted">{copy.svcIntro}</p>
      </div>
      <ol class="svc" data-reveal>
        {
          services.map((s, i) => (
            <li>
              <a class="svc__row" href={`/${s.slug}`}>
                <span class="svc__num tabular">{String(i + 1).padStart(2, '0')}</span>
                <span class="svc__main">
                  <span class="svc__name">{localName(lang, s.slug, s.name)}</span>
                  <span class="svc__short">{serviceShorts[lang][s.slug]}</span>
                </span>
                <span class="svc__range tabular">{s.range}</span>
                <span class="svc__thumb frame" aria-hidden="true">
                  <Image src={serviceImages[s.slug]} alt="" width={240} height={170} loading="lazy" />
                </span>
                <span class="svc__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="svc__note">
        <strong>{consultancyCopy[lang].name}.</strong> {consultancyCopy[lang].text}
      </p>
    </div>
  </section>

  <!-- Machinery -->
  <section class="section bg-paper-2">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="eyebrow">{copy.machEyebrow}</p>
          <h2 class="h2" set:html={copy.machTitle} />
        </div>
        <div class="mach__side">
          <p class="muted">{copy.machIntro}</p>
          <a class="link-arrow" href="/product">{copy.machAll} <span class="arrow">→</span></a>
        </div>
      </div>
      <ul class="mach-grid">
        {
          products.map((p, i) => (
            <li data-reveal>
              <ProductCard product={p} lang={lang} index={i} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Projects -->
  <section class="section bg-ink on-dark">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="eyebrow">{copy.projEyebrow}</p>
          <h2 class="h2" set:html={copy.projTitle} />
        </div>
        <p class="muted">{copy.projIntro}</p>
      </div>
      <ul class="proj" data-reveal>
        {
          copy.projects.map((p) => (
            <li class="proj__row">
              <p class="proj__scale tabular">{p.scale}</p>
              <div class="proj__client">
                <p class="proj__name">{p.client}</p>
                <p class="muted">{p.location}</p>
              </div>
              <p class="proj__scope">
                {p.scope}
                {p.note && <span class="muted"> · {p.note}</span>}
              </p>
              <p class:list={['proj__status', `is-${p.status.toLowerCase()}`]}>{copy.status[p.status]}</p>
            </li>
          ))
        }
      </ul>
      <div class="proj__foot">
        <a class="link-arrow" href="/projects">{copy.projAll} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section bg-white">
    <div class="container appr">
      <div class="appr__media" data-reveal>
        <div class="frame appr__frame">
          <Image
            src={approachImage}
            alt="Hind Zero Waste trommel and conveyor line working at a legacy waste site"
            widths={[480, 720]}
            sizes="(min-width: 900px) 40vw, 92vw"
            loading="lazy"
          />
        </div>
      </div>
      <div>
        <div data-reveal>
          <p class="eyebrow">{copy.apprEyebrow}</p>
          <h2 class="h2 appr__title" set:html={copy.apprTitle} />
        </div>
        <ol class="appr__steps">
          {
            approachSteps[lang].map(([title, text], i) => (
              <li data-reveal>
                <span class="appr__num tabular">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="h4">{title}</h3>
                  <p class="muted">{text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Clients -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="eyebrow">{copy.clientsEyebrow}</p>
          <h2 class="h2" set:html={copy.clientsTitle} />
        </div>
        <p class="muted">{copy.clientsIntro}</p>
      </div>
      <div data-reveal>
        <ClientWall />
      </div>
    </div>
  </section>

  <!-- Insights -->
  {
    posts.length > 0 && (
      <section class="section bg-white">
        <div class="container">
          <div class="section-head section-head--split" data-reveal>
            <div>
              <p class="eyebrow">{copy.insEyebrow}</p>
              <h2 class="h2" set:html={copy.insTitle} />
            </div>
            <div class="mach__side">
              <a class="link-arrow" href="/waste-management-blogs">
                {copy.insAll} <span class="arrow">→</span>
              </a>
            </div>
          </div>
          <ul class="ins">
            {posts.map((post) => (
              <li data-reveal>
                <a class="ins__card" href={`/${post.id}`}>
                  <p class="ins__topic">{post.data.topic}</p>
                  <h3 class="ins__title">{post.data.title}</h3>
                  <p class="muted ins__excerpt">{post.data.description}</p>
                  <span class="ins__more">
                    {copy.read} <span class="arrow">→</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand lang={lang} />
</Base>

<style>
  /* Hero */
  .hero {
    padding-top: clamp(40px, 6vw, 88px);
    padding-bottom: clamp(56px, 7vw, 96px);
  }

  .hero__top {
    display: grid;
    grid-template-columns: minmax(0, 7.5fr) minmax(0, 4.5fr);
    gap: 32px 64px;
    align-items: end;
  }

  .hero__title {
    margin-top: 24px;
  }

  .hero__aside {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-bottom: 12px;
  }

  .hero__figure {
    margin: clamp(40px, 6vw, 72px) 0 0;
  }

  .hero__frame {
    aspect-ratio: 16 / 7;
  }

  .hero__frame img {
    object-position: 50% 62%;
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(40px, 6vw, 72px) 0 0;
    border-top: 1px solid var(--line-strong);
  }

  .figures__item {
    padding: 28px 24px 0 0;
  }

  .figures__item + .figures__item {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .figures__value {
    font-family: var(--serif);
    font-size: clamp(2.8rem, 5vw, 4.4rem);
    line-height: 1;
    color: var(--ink);
  }

  .figures__label {
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 16em;
  }

  /* Philosophy */
  .phil {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 40px 80px;
  }

  .phil__title {
    margin-top: 20px;
  }

  .phil__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    padding-top: 40px;
  }

  /* Services */
  .svc {
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .svc li {
    border-bottom: 1px solid var(--line);
  }

  .svc__row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 160px 120px 32px;
    gap: 24px;
    align-items: center;
    padding: 28px 0;
    color: inherit;
    text-decoration: none;
  }

  .svc__num {
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--muted);
  }

  .svc__main {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .svc__name {
    font-family: var(--serif);
    font-size: clamp(1.7rem, 2.8vw, 2.4rem);
    line-height: 1.08;
    color: var(--ink);
    transition: color 0.25s var(--ease);
  }

  .svc__short {
    color: var(--muted);
    font-size: 15px;
  }

  .svc__range {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .svc__thumb {
    width: 120px;
    aspect-ratio: 12 / 8.5;
    opacity: 0.85;
    transition: opacity 0.4s var(--ease);
  }

  .svc__arrow {
    font-size: 1.3rem;
    transition: transform 0.3s var(--ease);
  }

  .svc__row:hover .svc__name {
    color: var(--navy);
  }

  .svc__row:hover .svc__thumb {
    opacity: 1;
  }

  .svc__row:hover .svc__arrow {
    transform: translateX(6px);
  }

  .svc__note {
    margin-top: 28px;
    max-width: 52em;
    color: var(--muted);
    font-size: 15px;
  }

  .svc__note strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* Machinery */
  .mach__side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .mach-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 32px;
    list-style: none;
  }

  /* Projects */
  .proj {
    list-style: none;
    border-top: 1px solid var(--line-on-dark);
  }

  .proj__row {
    display: grid;
    grid-template-columns: minmax(0, 2.4fr) minmax(0, 3.6fr) minmax(0, 4fr) minmax(0, 1.4fr);
    gap: 16px 32px;
    align-items: baseline;
    padding: 28px 0;
    border-bottom: 1px solid var(--line-on-dark);
  }

  .proj__scale {
    font-family: var(--serif);
    font-size: clamp(1.8rem, 2.6vw, 2.3rem);
    line-height: 1.05;
    color: var(--paper);
  }

  .proj__name {
    color: var(--paper);
    font-weight: 600;
  }

  .proj__client .muted {
    font-size: 14px;
  }

  .proj__scope {
    color: #cdd5e2;
    font-size: 15px;
  }

  .proj__status {
    justify-self: end;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-on-dark);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .proj__status::before {
    content: '';
    width: 7px;
    height: 7px;
    background: var(--muted-on-dark);
  }

  .proj__status.is-ongoing::before {
    background: var(--lime);
  }

  .proj__status.is-completed::before,
  .proj__status.is-commissioned::before {
    background: var(--green);
  }

  .proj__foot {
    margin-top: 40px;
  }

  /* Approach */
  .appr {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px 88px;
    align-items: start;
  }

  .appr__frame {
    aspect-ratio: 4 / 5;
  }

  .appr__media {
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }

  .appr__title {
    margin-top: 20px;
  }

  .appr__steps {
    list-style: none;
    margin-top: 48px;
    border-top: 1px solid var(--line-strong);
  }

  .appr__steps li {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 20px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }

  .appr__steps .muted {
    margin-top: 8px;
  }

  .appr__num {
    font-family: var(--serif);
    font-size: 2rem;
    line-height: 1;
    color: var(--navy);
  }

  /* Insights */
  .ins {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    list-style: none;
  }

  .ins__card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    padding: 32px 0 0;
    border-top: 1px solid var(--line-strong);
    color: inherit;
    text-decoration: none;
  }

  .ins__topic {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green-ink);
  }

  .ins__title {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.2vw, 1.9rem);
    line-height: 1.12;
    color: var(--ink);
    transition: color 0.25s var(--ease);
  }

  .ins__excerpt {
    font-size: 15px;
  }

  .ins__more {
    margin-top: auto;
    padding-top: 8px;
    font-weight: 600;
    font-size: 14px;
  }

  .ins__card:hover .ins__title {
    color: var(--navy);
  }

  @media (max-width: 1080px) {
    .svc__row {
      grid-template-columns: 52px minmax(0, 1fr) 140px 28px;
    }

    .svc__thumb {
      display: none;
    }

    .mach-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .proj__row {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr) minmax(0, 1.2fr);
    }

    .proj__scope {
      grid-column: 2 / 3;
    }

    .proj__status {
      grid-row: 1;
      grid-column: 3;
    }
  }

  @media (max-width: 900px) {
    .hero__top,
    .phil,
    .appr {
      grid-template-columns: minmax(0, 1fr);
    }

    .phil__body {
      padding-top: 0;
    }

    .appr__media {
      position: static;
    }

    .appr__frame {
      aspect-ratio: 16 / 10;
    }

    .figures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .figures__item + .figures__item:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .figures__item:nth-child(n + 3) {
      margin-top: 8px;
      border-top: 1px solid var(--line);
    }

    .ins {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 680px) {
    .hero__frame {
      aspect-ratio: 4 / 3;
    }

    .svc__row {
      grid-template-columns: 40px minmax(0, 1fr) 24px;
      gap: 16px;
    }

    .svc__range {
      grid-column: 2;
      grid-row: 2;
    }

    .svc__arrow {
      grid-column: 3;
      grid-row: 1;
    }

    .mach-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }

    .proj__row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .proj__scale {
      grid-column: 1;
    }

    .proj__status {
      grid-column: 2;
      grid-row: 1;
    }

    .proj__client,
    .proj__scope {
      grid-column: 1 / -1;
    }

    .appr__steps li {
      grid-template-columns: 52px minmax(0, 1fr);
    }
  }
</style>
