<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Hero slideshow
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-goto]')];
    let current = 0;
    let timer: number | undefined;
    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle('is-active', i === current));
      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i === current);
        d.setAttribute('aria-pressed', String(i === current));
      });
      // Restart the progress bar animation on the active dot.
      const bar = dots[current]?.querySelector<HTMLElement>('.hero__bar');
      if (bar) {
        bar.style.animation = 'none';
        void bar.offsetWidth;
        bar.style.animation = '';
      }
    };
    const play = () => {
      if (reduce) return;
      window.clearInterval(timer);
      timer = window.setInterval(() => show(current + 1), 6500);
    };
    dots.forEach((d) =>
      d.addEventListener('click', () => {
        show(Number(d.dataset.goto));
        play();
      }),
    );
    document.addEventListener('visibilitychange', () => (document.hidden ? window.clearInterval(timer) : play()));
    if (reduce) hero.classList.add('is-still');
    play();
  }

  // Philosophy: light up one word at a time as the section scrolls past.
  const phil = document.querySelector<HTMLElement>('[data-phil]');
  if (phil) {
    const words = [...phil.querySelectorAll<HTMLElement>('[data-word]')];
    const update = () => {
      const rect = phil.getBoundingClientRect();
      const range = Math.max(1, rect.height - window.innerHeight * 0.6);
      const progress = Math.min(1, Math.max(0, (window.innerHeight * 0.35 - rect.top) / range));
      const active = Math.min(words.length - 1, Math.floor(progress * words.length));
      words.forEach((w, i) => w.classList.toggle('is-on', i <= active));
    };
    if (reduce || window.matchMedia('(max-width: 899px)').matches) {
      words.forEach((w) => w.classList.add('is-on'));
    } else {
      update();
      window.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    }
  }

  // Machinery filters
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const grid = document.querySelector<HTMLElement>('[data-filter-grid]');
  if (filters && grid) {
    const buttons = [...filters.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-cat]')];
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const key = btn.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        // On phones the row scrolls sideways; keep the chosen chip in view.
        btn.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
        cards.forEach((card) => {
          const show = key === 'featured' ? 'featured' in card.dataset : card.dataset.cat === key;
          card.hidden = !show;
          if (show) {
            card.classList.remove('is-entering');
            void card.offsetWidth;
            card.classList.add('is-entering');
          }
        });
      }),
    );
  }
</script>

