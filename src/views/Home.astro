const categories = [...new Set(products.map((p) => p.category))];
// One machine from each core category for the home page; the full range is on /product.
const featured = new Set([
  'rotary-trommel-machines',
  'air-density-separator',
  'industrial-shredder-machine',
  'hydraulic-baler-machine',
  'organic-waste-composter-machine',
  'conveyor-and-conveying-system',
]);
const catKey = (c: string) => c.toLowerCase().replace(/[^a-z]+/g, '-');

const puneBg = await getImage({ src: pune, width: 1600, format: 'webp' });

const posts =
  lang === 'en'
    ? (await getCollection('blog'))
        .sort((a, b) => a.data.order - b.data.order)
        .slice(0, 3)
        .map((p) => ({ post: p, minutes: Math.max(2, Math.round((p.body ?? '').split(/\s+/).length / 200)) }))
    : [];
const alternates = { en: '/', hi: '/hi/', mr: '/mr/' };
const aboutHref = localePath(lang, '/about-us');
---

<Base title={copy.title} description={copy.description} lang={lang} alternates={alternates}>
  <!-- Hero: a complete first screen with a rotating photo backdrop -->
  <section class="hero on-dark" data-hero>
    <div class="hero__slides">
      {
        slides.map((s, i) => (
          <div class:list={['hero__slide', { 'is-active': i === 0 }]} data-slide={i}>
            <Image
              src={s.src}
              alt={i === 0 ? s.alt : ''}
              widths={[800, 1200, 1600]}
              sizes="100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'low'}
            />
          </div>
        ))
      }
    </div>
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="container hero__inner">
      <div class="hero__content">
        <h1 class="display hero__title rise">
          {
            copy.heroWords.map(([word, em], i) => (
              <>
                <span style={`--i:${i}`}>{em ? <em>{word}</em> : word}</span>{' '}
              </>
            ))
          }
        </h1>
        <p class="eyebrow hero__sub" data-reveal style="--d: 4">{copy.heroSub}</p>
        <p class="hero__lead" data-reveal style="--d: 5">
          <span class="hero__lead-full">{copy.heroLead}</span>
          <span class="hero__lead-short">{copy.heroLeadShort}</span>
        </p>
        <div class="btn-row" data-reveal style="--d: 6">
          <a class="btn btn--accent" href={localePath(lang, '/contact-us') + '#enquiry'}>{t(lang, 'cta.quote')} <span class="arrow">→</span></a>
