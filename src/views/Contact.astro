</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-enquiry]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const summary = form.querySelector<HTMLElement>('[data-summary-box]')!;
    const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const buttonLabel = button.querySelector<HTMLElement>('[data-submit-label]')!;
    const idleLabel = buttonLabel.textContent ?? '';
    const done = document.querySelector<HTMLElement>('[data-done]')!;
    const select = form.querySelector<HTMLSelectElement>('select[name="requirement"]')!;
    const message = form.querySelector<HTMLTextAreaElement>('textarea[name="message"]')!;
    let sending = false;

    // Pre-fill the requirement from ?subject= (set by "Request a quote" buttons on product pages).
    const subject = new URLSearchParams(window.location.search).get('subject');
    if (subject) {
      const match = [...select.options].find((o) => o.value === subject);
      if (match) select.value = match.value;
      else if (!message.value) message.value = subject;
    }

    const rules: Record<string, (v: string) => boolean> = {
      name: (v) => v.length > 0,
      phone: (v) => /^[+\d\s().-]+$/.test(v) && v.replace(/\D/g, '').length >= 7,
      email: (v) => !v || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v),
      requirement: (v) => v.length > 0,
    };

    const setFieldError = (name: string, invalid: boolean) => {
      const el = form.elements.namedItem(name) as HTMLInputElement | null;
      const msg = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (!el || !msg) return;
      el.setAttribute('aria-invalid', String(invalid));
      msg.textContent = invalid ? (msg.dataset.msg ?? '') : '';
    };

    const validate = () => {
      const bad = Object.keys(rules).filter((name) => {
        const el = form.elements.namedItem(name) as HTMLInputElement;
        const invalid = !rules[name](el.value.trim());
        setFieldError(name, invalid);
        return invalid;
      });
      return bad;
    };

    // Re-check a field as soon as the visitor fixes it.
    Object.keys(rules).forEach((name) => {
      const el = form.elements.namedItem(name) as HTMLInputElement;
      const recheck = () => {
        if (el.getAttribute('aria-invalid') === 'true') setFieldError(name, !rules[name](el.value.trim()));
      };
      el.addEventListener('input', recheck);
      el.addEventListener('change', recheck);
      el.addEventListener('blur', () => {
        if (el.value.trim() || el.getAttribute('aria-invalid')) setFieldError(name, !rules[name](el.value.trim()));
      });
    });

    const setSending = (on: boolean) => {
      sending = on;
      button.disabled = on;
      button.setAttribute('aria-busy', String(on));
      form.toggleAttribute('data-busy', on);
      buttonLabel.textContent = on ? (form.dataset.sending ?? idleLabel) : idleLabel;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return; // no duplicate submissions
      status.textContent = '';
      delete status.dataset.state;

      const bad = validate();
      if (bad.length) {
        summary.textContent = form.dataset.summary ?? '';
        summary.hidden = false;
        (form.elements.namedItem(bad[0]) as HTMLElement).focus();
        return;
      }
      summary.hidden = true;

      const data = new FormData(form);
      data.set('lang', form.dataset.lang ?? 'en');
      setSending(true);
      try {
        const res = await fetch(form.dataset.endpoint ?? '', {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
          signal: AbortSignal.timeout(20000),
        });
        const body = await res.json().catch(() => null);
        if (!res.ok || !body?.ok) throw new Error(String(res.status));
        form.reset();
        form.hidden = true;
        done.hidden = false;
        done.focus();
      } catch {
        // Keep everything the visitor typed; only show the error.
        status.textContent = form.dataset.error ?? '';
        status.dataset.state = 'error';
      } finally {
        setSending(false);
      }
    });

    done.querySelector('[data-again]')?.addEventListener('click', () => {
      done.hidden = true;
      form.hidden = false;
      (form.elements.namedItem('name') as HTMLElement).focus();
    });
  }
</script>


