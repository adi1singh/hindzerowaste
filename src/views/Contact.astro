---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, telHref } from '../data/site';
import { products } from '../data/products';
import { services } from '../data/services';
import { localName, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  en: {
    title: 'Contact Us | Request a Quote',
    description:
      'Contact Hind Zero Waste Management, Kolhapur, for bio-mining, MSW, MRF and RDF plants and waste-processing machinery. Call +91 96370 01919 or send an enquiry.',
    crumbs: ['Home', 'Contact'],
    eyebrow: 'Contact',
    heroTitle: 'Let’s talk about your <em>project</em>.',
    lead: 'Tell us about your waste, tonnage and site. Our engineers will recommend a configuration and prepare a quotation.',
    formTitle: 'Send an enquiry',
    required: 'Required',
    name: 'Name',
    org: 'Organisation',
    phone: 'Phone',
    email: 'Email',
    city: 'City / State',
    requirement: 'Requirement',
    choose: 'Select a requirement',
    servicesGroup: 'Turnkey plants',
    machineryGroup: 'Machinery',
    other: 'Other',
    capacity: 'Approximate capacity (e.g. TPD)',
    message: 'Message',
    messagePlaceholder: 'Waste type, quantity, site location, timeline…',
    send: 'Send enquiry',
    mailNote: `Sending opens your email app with your enquiry ready to send to ${site.emails.sales}.`,
    success: 'Thank you. Our team will be in touch shortly.',
    error: `Something went wrong. Please call us or email ${site.emails.sales}.`,
    call: 'Call',
    emailLabel: 'Email',
    office: 'Office',
    map: 'Open in Google Maps',
    downloads: 'Downloads',
    brochure: 'Brochure (PDF)',
    profile: 'Company profile (PDF)',
    subjectPrefix: 'Enquiry',
    quick: ['Call us', 'Email us', 'Visit us'],
    hours: 'Tell us about your project and our team will get back to you.',
  },
  hi: {
    title: 'संपर्क करें | कोटेशन माँगें',
    description:
      'बायो-माइनिंग, MSW, MRF और RDF प्लांट तथा कचरा प्रसंस्करण मशीनरी के लिए हिंद ज़ीरो वेस्ट मैनेजमेंट, कोल्हापुर से संपर्क करें। कॉल करें +91 96370 01919।',
    crumbs: ['होम', 'संपर्क'],
    eyebrow: 'संपर्क',
    heroTitle: 'आइए, आपकी <em>परियोजना</em> पर बात करें।',
    lead: 'अपने कचरे, क्षमता और साइट के बारे में बताइए। हमारे इंजीनियर उपयुक्त कॉन्फ़िगरेशन सुझाकर कोटेशन तैयार करेंगे।',
    formTitle: 'पूछताछ भेजें',
    required: 'आवश्यक',
    name: 'नाम',
    org: 'संस्था',
    phone: 'फ़ोन',
    email: 'ईमेल',
    city: 'शहर / राज्य',
    requirement: 'आवश्यकता',
    choose: 'आवश्यकता चुनें',
    servicesGroup: 'टर्नकी प्लांट',
    machineryGroup: 'मशीनरी',
    other: 'अन्य',
    capacity: 'अनुमानित क्षमता (जैसे TPD)',
    message: 'संदेश',
    messagePlaceholder: 'कचरे का प्रकार, मात्रा, साइट का स्थान, समय-सीमा…',
    send: 'पूछताछ भेजें',
    mailNote: `भेजने पर आपका ईमेल ऐप खुलेगा, जिसमें ${site.emails.sales} को भेजने के लिए आपकी पूछताछ तैयार होगी।`,
    success: 'धन्यवाद। हमारी टीम जल्द ही आपसे संपर्क करेगी।',
    error: `कुछ गड़बड़ हुई। कृपया हमें कॉल करें या ${site.emails.sales} पर ईमेल भेजें।`,
    call: 'कॉल करें',
    emailLabel: 'ईमेल',
    office: 'कार्यालय',
    map: 'Google Maps में खोलें',
    downloads: 'डाउनलोड',
    brochure: 'ब्रोशर (PDF)',
    profile: 'कंपनी प्रोफ़ाइल (PDF)',
    subjectPrefix: 'पूछताछ',
    quick: ['कॉल करें', 'ईमेल करें', 'हमसे मिलें'],
    hours: 'अपनी परियोजना के बारे में बताइए, हमारी टीम आपसे संपर्क करेगी।',
  },
  mr: {
    title: 'संपर्क | कोटेशन मागवा',
    description:
      'बायो-मायनिंग, MSW, MRF व RDF प्लांट तसेच कचरा प्रक्रिया यंत्रसामग्रीसाठी हिंद झिरो वेस्ट मॅनेजमेंट, कोल्हापूरशी संपर्क साधा. कॉल करा +91 96370 01919.',
    crumbs: ['होम', 'संपर्क'],
    eyebrow: 'संपर्क',
    heroTitle: 'चला, तुमच्या <em>प्रकल्पाबद्दल</em> बोलूया.',
    lead: 'तुमचा कचरा, क्षमता आणि साइटबद्दल सांगा. आमचे अभियंते योग्य रचना सुचवून कोटेशन तयार करतील.',
    formTitle: 'चौकशी पाठवा',
    required: 'आवश्यक',
    name: 'नाव',
    org: 'संस्था',
    phone: 'फोन',
    email: 'ईमेल',
    city: 'शहर / राज्य',
    requirement: 'गरज',
    choose: 'गरज निवडा',
    servicesGroup: 'टर्नकी प्लांट',
    machineryGroup: 'यंत्रसामग्री',
    other: 'इतर',
    capacity: 'अंदाजे क्षमता (उदा. TPD)',
    message: 'संदेश',
    messagePlaceholder: 'कचऱ्याचा प्रकार, प्रमाण, साइटचे ठिकाण, कालमर्यादा…',
    send: 'चौकशी पाठवा',
    mailNote: `पाठवल्यावर तुमचे ईमेल ॲप उघडेल, ज्यामध्ये ${site.emails.sales} ला पाठवण्यासाठी तुमची चौकशी तयार असेल.`,
    success: 'धन्यवाद. आमची टीम लवकरच तुमच्याशी संपर्क साधेल.',
    error: `काहीतरी चूक झाली. कृपया आम्हाला कॉल करा किंवा ${site.emails.sales} वर ईमेल पाठवा.`,
    call: 'कॉल करा',
    emailLabel: 'ईमेल',
    office: 'कार्यालय',
    map: 'Google Maps मध्ये उघडा',
    downloads: 'डाउनलोड',
    brochure: 'ब्रोशर (PDF)',
    profile: 'कंपनी प्रोफाइल (PDF)',
    subjectPrefix: 'चौकशी',
    quick: ['कॉल करा', 'ईमेल करा', 'भेट द्या'],
    hours: 'तुमच्या प्रकल्पाबद्दल सांगा, आमची टीम तुमच्याशी संपर्क साधेल.',
  },
}[lang];

const home = lang === 'en' ? '/' : `/${lang}/`;
const alternates = { en: '/contact-us', hi: '/hi/contact-us', mr: '/mr/contact-us' };
const endpoint = site.enquiryEndpoint as string;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: copy.title,
    url: `${site.url}${alternates[lang]}`,
  },
];
---

<Base title={copy.title} description={copy.description} lang={lang} alternates={alternates} schema={schema}>
  <section class="chero on-dark">
    <div class="container chero__inner">
      <nav class="chero__crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href={home}>{copy.crumbs[0]}</a></li>
          <li><span aria-current="page">{copy.crumbs[1]}</span></li>
        </ol>
      </nav>
      <p class="eyebrow" data-reveal>{copy.eyebrow}</p>
      <h1 class="h1 chero__title" data-reveal style="--d: 1" set:html={copy.heroTitle} />
      <p class="lead chero__lead" data-reveal style="--d: 2">{copy.lead}</p>
      <ul class="quick">
        <li data-reveal style="--d: 3">
          <a class="quick__tile" href={telHref(site.phones[0])}>
            <span class="quick__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"></path></svg>
            </span>
            <span class="quick__label">{copy.quick[0]}</span>
            <span class="quick__value tabular">{site.phones[0]}</span>
          </a>
        </li>
        <li data-reveal style="--d: 4">
          <a class="quick__tile" href={`mailto:${site.emails.sales}`}>
            <span class="quick__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
            </span>
            <span class="quick__label">{copy.quick[1]}</span>
            <span class="quick__value">{site.emails.sales}</span>
          </a>
        </li>
        <li data-reveal style="--d: 5">
          <a class="quick__tile" href={site.mapUrl} target="_blank" rel="noopener">
            <span class="quick__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
            </span>
            <span class="quick__label">{copy.quick[2]}</span>
            <span class="quick__value">Rajarampuri, {site.address.city}</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="contact-wrap">
    <div class="container contact">
      <div class="form-card" id="enquiry" data-reveal>
        <div class="form-card__head">
          <span class="form-card__icon"><Icon name="consult" size={26} /></span>
          <div>
            <h2 class="h3">{copy.formTitle}</h2>
            <p class="muted form-card__hours">{copy.hours}</p>
          </div>
        </div>
        <form
          class="form"
          data-enquiry
          data-endpoint={endpoint}
          data-to={site.emails.sales}
          data-subject={copy.subjectPrefix}
          novalidate
        >
          <div class="field">
            <label for="f-name">{copy.name} <span aria-hidden="true">*</span></label>
            <input id="f-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="f-org">{copy.org}</label>
            <input id="f-org" name="organisation" type="text" autocomplete="organization" />
          </div>
          <div class="field">
            <label for="f-phone">{copy.phone} <span aria-hidden="true">*</span></label>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
          </div>
          <div class="field">
            <label for="f-email">{copy.email}</label>
            <input id="f-email" name="email" type="email" autocomplete="email" />
          </div>
          <div class="field">
            <label for="f-city">{copy.city}</label>
            <input id="f-city" name="city" type="text" autocomplete="address-level2" />
          </div>
          <div class="field">
            <label for="f-capacity">{copy.capacity}</label>
            <input id="f-capacity" name="capacity" type="text" />
          </div>
          <div class="field field--full">
            <label for="f-req">{copy.requirement} <span aria-hidden="true">*</span></label>
            <select id="f-req" name="requirement" required>
              <option value="">{copy.choose}</option>
              <optgroup label={copy.servicesGroup}>
                {services.map((s) => <option value={s.name}>{localName(lang, s.slug, s.name)}</option>)}
              </optgroup>
              <optgroup label={copy.machineryGroup}>
                {products.map((p) => <option value={p.name}>{localName(lang, p.slug, p.name)}</option>)}
              </optgroup>
              <option value="Other">{copy.other}</option>
            </select>
          </div>
          <div class="field field--full">
            <label for="f-msg">{copy.message}</label>
            <textarea id="f-msg" name="message" rows="5" placeholder={copy.messagePlaceholder}></textarea>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="f-website">Website</label>
            <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="form__foot field--full">
            <button class="btn btn--accent" type="submit">{copy.send} <span class="arrow">→</span></button>
            <p class="form__note">
              <span>* {copy.required}.</span>
              {!endpoint && <span> {copy.mailNote}</span>}
            </p>
          </div>
          <p class="form__status" role="status" aria-live="polite" data-status data-success={copy.success} data-error={copy.error}></p>
        </form>
      </div>

      <aside class="details on-dark" data-reveal style="--d: 1">
        <div class="details__block">
          <p class="details__label">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"></path></svg>
            {copy.call}
          </p>
          <ul class="details__phones">
            {
              site.phones.map((p) => (
                <li>
                  <a href={telHref(p)}>{p}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="details__block">
          <p class="details__label">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
            {copy.emailLabel}
          </p>
          <ul class="details__mail">
            {
              Object.values(site.emails).map((e) => (
                <li>
                  <a href={`mailto:${e}`}>{e}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="details__block">
          <p class="details__label">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
            {copy.office}
          </p>
          <address>
            <strong>{site.name}</strong>
            {site.address.lines.map((l) => <span>{l}</span>)}
            <span>{site.address.city} {site.address.postcode}</span>
            <span>{site.address.region}, {site.address.country}</span>
          </address>
          <a class="link-arrow" href={site.mapUrl} target="_blank" rel="noopener">{copy.map} <span class="arrow">↗</span></a>
        </div>
        <div class="details__block">
          <p class="details__label">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>
            {copy.downloads}
          </p>
          <div class="details__downloads">
            <a class="link-arrow" href={site.downloads.brochure} target="_blank" rel="noopener">{copy.brochure} <span class="arrow">↗</span></a>
            <a class="link-arrow" href={site.downloads.profile} target="_blank" rel="noopener">{copy.profile} <span class="arrow">↗</span></a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-enquiry]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const select = form.querySelector<HTMLSelectElement>('select[name="requirement"]')!;
    const message = form.querySelector<HTMLTextAreaElement>('textarea[name="message"]')!;

    // Pre-fill the requirement from ?subject= (set by "Request a quote" buttons on product pages).
    const subject = new URLSearchParams(window.location.search).get('subject');
    if (subject) {
      const match = [...select.options].find((o) => o.value === subject);
      if (match) select.value = match.value;
      else if (!message.value) message.value = subject;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = '';
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const data = new FormData(form);
      if (data.get('website')) return; // spam trap

      const endpoint = form.dataset.endpoint;
      if (endpoint) {
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        button.disabled = true;
        try {
          const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          status.textContent = status.dataset.success ?? '';
          status.dataset.state = 'success';
        } catch {
          status.textContent = status.dataset.error ?? '';
          status.dataset.state = 'error';
        } finally {
          button.disabled = false;
        }
        return;
      }

      // No form service yet: open the visitor's email app with the enquiry filled in.
      const labels: Record<string, string> = {
        name: 'Name',
        organisation: 'Organisation',
        phone: 'Phone',
        email: 'Email',
        city: 'City / State',
        requirement: 'Requirement',
        capacity: 'Capacity',
        message: 'Message',
      };
      const lines = Object.entries(labels)
        .map(([key, label]) => [label, String(data.get(key) ?? '').trim()])
        .filter(([, value]) => value)
        .map(([label, value]) => `${label}: ${value}`);
      const subjectLine = `${form.dataset.subject}: ${data.get('requirement')}${data.get('organisation') ? ` – ${data.get('organisation')}` : ''}`;
      window.location.href = `mailto:${form.dataset.to}?subject=${encodeURIComponent(subjectLine)}&body=${encodeURIComponent(lines.join('\n'))}`;
    });
  }
</script>


<style>
  /* Hero */
  .chero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 6vw, 72px) clamp(150px, 16vw, 210px);
    background: radial-gradient(120% 140% at 0% 0%, var(--navy) 0%, var(--navy-deep) 45%, var(--ink) 100%);
    color: #e8e0d6;
  }

  .chero::after {
    content: '';
    position: absolute;
    right: -10%;
    top: -30%;
    width: 50vw;
    height: 50vw;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(200, 100, 59, 0.25), transparent 62%);
    animation: drift 12s ease-in-out infinite alternate;
    pointer-events: none;
  }

  @keyframes drift {
    to {
      transform: translate(-10%, 10%) scale(1.1);
    }
  }

  .chero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .chero__crumbs ol {
    display: flex;
    gap: 6px;
    list-style: none;
    font-size: 14px;
    opacity: 0.8;
  }

  .chero__crumbs li + li::before {
    content: '/';
    margin-right: 6px;
    opacity: 0.6;
  }

  .chero__crumbs a {
    color: inherit;
    text-decoration: none;
  }

  .chero__title {
    color: var(--white);
    max-width: 14em;
  }

  .chero__lead {
    max-width: 36em;
  }

  .quick {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
    margin-top: 20px;
    list-style: none;
  }

  .quick__tile {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 16px;
    align-items: center;
    padding: 20px 22px;
    border-radius: var(--radius-lg);
    background: rgba(246, 243, 236, 0.07);
    border: 1px solid var(--line-on-dark);
    color: var(--paper);
    text-decoration: none;
    transition:
      transform 0.45s var(--ease-out),
      background-color 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  .quick__icon {
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--saffron);
    color: var(--ink);
  }

  .quick__label {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--saffron-2);
  }

  .quick__value {
    font-size: 18px;
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  .quick__tile:hover {
    transform: translateY(-6px);
    background: rgba(246, 243, 236, 0.12);
    border-color: var(--saffron);
  }

  /* Form and details */
  .contact-wrap {
    position: relative;
    z-index: 2;
    margin-top: calc(-1 * clamp(110px, 12vw, 160px));
    padding-bottom: var(--section);
  }

