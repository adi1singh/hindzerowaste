---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { figures, site, telHref } from '../data/site';
import trustPhoto from '../assets/photos/biomining-trommel-site.jpg';
import { products } from '../data/products';
import { services } from '../data/services';
import { localName, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  en: {
    title: 'Contact Us | Request a Quote',
    description:
      'Contact Hind Zero Waste Management, Kolhapur, for bio-mining, MSW, MRF and RDF plants and waste-processing machinery. Call +91 96370 01919 or send an enquiry.',
    crumbs: ['Home', 'Contact'],
    eyebrow: 'Contact',
    heroTitle: 'Let’s talk about your <em>project</em>.',
    lead: 'Tell us about your waste, tonnage and site. Our engineers will recommend a configuration and prepare a quotation.',
    formTitle: 'Send an enquiry',
    required: 'Required',
    name: 'Name',
    org: 'Organisation',
    phone: 'Phone',
    email: 'Email',
    city: 'City / State',
    requirement: 'Requirement',
    choose: 'Select a requirement',
    servicesGroup: 'Turnkey plants',
    machineryGroup: 'Machinery',
    other: 'Other',
    capacity: 'Capacity',
    capacityHint: 'Tonnes per day, if known.',
    message: 'Message',
    messagePlaceholder: 'Waste type, quantity, site location, timeline…',
    send: 'Send enquiry',
    call: 'Call',
    emailLabel: 'Email',
    office: 'Office',
    map: 'Open in Google Maps',
    downloads: 'Downloads',
    brochure: 'Brochure (PDF)',
    profile: 'Company profile (PDF)',
    subjectPrefix: 'Enquiry',
    quick: ['Call us', 'Email us', 'Visit us'],
    hours: 'Tell us about your project and our team will get back to you.',
    sending: 'Sending…',
    successTitle: 'Thank you. Your enquiry has been sent.',
    successText: 'Our team will contact you using the details you provided.',
    error: `Your enquiry could not be sent. Everything you entered is still here, so you can try again, or call ${site.phones[0]} or email ${site.emails.sales}.`,
    summary: 'Please check the highlighted fields.',
    errName: 'Please enter your name.',
    errPhone: 'Please enter a phone number with at least 7 digits.',
    errEmail: 'Please enter a valid email address, or leave this blank.',
    errReq: 'Please choose a requirement.',
    privacy: 'We use your details only to respond to your enquiry.',
    privacyLink: 'Privacy Policy',
    another: 'Send another enquiry',
    trustAlt: 'Bio-mining trommel line processing legacy waste at a dumpsite',
    whatsapp: 'WhatsApp',
  },
  hi: {
    title: 'संपर्क करें | कोटेशन माँगें',
    description:
      'बायो-माइनिंग, MSW, MRF और RDF प्लांट तथा कचरा प्रसंस्करण मशीनरी के लिए हिंद ज़ीरो वेस्ट मैनेजमेंट, कोल्हापुर से संपर्क करें। कॉल करें +91 96370 01919।',
    crumbs: ['होम', 'संपर्क'],
    eyebrow: 'संपर्क',
    heroTitle: 'आइए, आपकी <em>परियोजना</em> पर बात करें।',
    lead: 'अपने कचरे, क्षमता और साइट के बारे में बताइए। हमारे इंजीनियर उपयुक्त कॉन्फ़िगरेशन सुझाकर कोटेशन तैयार करेंगे।',
    formTitle: 'पूछताछ भेजें',
    required: 'आवश्यक',
    name: 'नाम',
    org: 'संस्था',
    phone: 'फ़ोन',
    email: 'ईमेल',
    city: 'शहर / राज्य',
    requirement: 'आवश्यकता',
    choose: 'आवश्यकता चुनें',
    servicesGroup: 'टर्नकी प्लांट',
    machineryGroup: 'मशीनरी',
    other: 'अन्य',
    capacity: 'क्षमता',
    capacityHint: 'टन प्रति दिन, यदि ज्ञात हो।',
    message: 'संदेश',
    messagePlaceholder: 'कचरे का प्रकार, मात्रा, साइट का स्थान, समय-सीमा…',
    send: 'पूछताछ भेजें',
    call: 'कॉल करें',
    emailLabel: 'ईमेल',
    office: 'कार्यालय',
    map: 'Google Maps में खोलें',
    downloads: 'डाउनलोड',
    brochure: 'ब्रोशर (PDF)',
    profile: 'कंपनी प्रोफ़ाइल (PDF)',
    subjectPrefix: 'पूछताछ',
    quick: ['कॉल करें', 'ईमेल करें', 'हमसे मिलें'],
    hours: 'अपनी परियोजना के बारे में बताइए, हमारी टीम आपसे संपर्क करेगी।',
    sending: 'भेजा जा रहा है…',
    successTitle: 'धन्यवाद। आपकी पूछताछ भेज दी गई है।',
    successText: 'हमारी टीम आपके दिए गए विवरण पर आपसे संपर्क करेगी।',
    error: `आपकी पूछताछ भेजी नहीं जा सकी। आपकी भरी हुई जानकारी सुरक्षित है, आप फिर से कोशिश कर सकते हैं, या ${site.phones[0]} पर कॉल करें या ${site.emails.sales} पर ईमेल करें।`,
    summary: 'कृपया चिह्नित फ़ील्ड जाँचें।',
    errName: 'कृपया अपना नाम लिखें।',
    errPhone: 'कृपया कम से कम 7 अंकों का फ़ोन नंबर लिखें।',
    errEmail: 'कृपया सही ईमेल पता लिखें, या इसे खाली छोड़ दें।',
    errReq: 'कृपया एक आवश्यकता चुनें।',
    privacy: 'आपकी जानकारी का उपयोग केवल आपकी पूछताछ का उत्तर देने के लिए किया जाता है।',
    privacyLink: 'गोपनीयता नीति',
    another: 'एक और पूछताछ भेजें',
    trustAlt: 'डंपसाइट पर पुराने कचरे का प्रसंस्करण करती बायो-माइनिंग ट्रोमेल लाइन',
    whatsapp: 'WhatsApp',
  },
  mr: {
    title: 'संपर्क | कोटेशन मागवा',
    description:
      'बायो-मायनिंग, MSW, MRF व RDF प्लांट तसेच कचरा प्रक्रिया यंत्रसामग्रीसाठी हिंद झिरो वेस्ट मॅनेजमेंट, कोल्हापूरशी संपर्क साधा. कॉल करा +91 96370 01919.',
    crumbs: ['होम', 'संपर्क'],
    eyebrow: 'संपर्क',
    heroTitle: 'चला, तुमच्या <em>प्रकल्पाबद्दल</em> बोलूया.',
    lead: 'तुमचा कचरा, क्षमता आणि साइटबद्दल सांगा. आमचे अभियंते योग्य रचना सुचवून कोटेशन तयार करतील.',
    formTitle: 'चौकशी पाठवा',
    required: 'आवश्यक',
    name: 'नाव',
    org: 'संस्था',
    phone: 'फोन',
    email: 'ईमेल',
    city: 'शहर / राज्य',
    requirement: 'गरज',
    choose: 'गरज निवडा',
    servicesGroup: 'टर्नकी प्लांट',
    machineryGroup: 'यंत्रसामग्री',
    other: 'इतर',
    capacity: 'क्षमता',
    capacityHint: 'टन प्रतिदिन, माहीत असल्यास.',
    message: 'संदेश',
    messagePlaceholder: 'कचऱ्याचा प्रकार, प्रमाण, साइटचे ठिकाण, कालमर्यादा…',
    send: 'चौकशी पाठवा',
    call: 'कॉल करा',
    emailLabel: 'ईमेल',
    office: 'कार्यालय',
    map: 'Google Maps मध्ये उघडा',
    downloads: 'डाउनलोड',
    brochure: 'ब्रोशर (PDF)',
    profile: 'कंपनी प्रोफाइल (PDF)',
    subjectPrefix: 'चौकशी',
    quick: ['कॉल करा', 'ईमेल करा', 'भेट द्या'],
    hours: 'तुमच्या प्रकल्पाबद्दल सांगा, आमची टीम तुमच्याशी संपर्क साधेल.',
    sending: 'पाठवत आहे…',
    successTitle: 'धन्यवाद. तुमची चौकशी पाठवली आहे.',
    successText: 'तुम्ही दिलेल्या तपशिलांवर आमची टीम तुमच्याशी संपर्क साधेल.',
    error: `तुमची चौकशी पाठवता आली नाही. तुम्ही भरलेली माहिती जशीच्या तशी आहे, पुन्हा प्रयत्न करा, किंवा ${site.phones[0]} वर कॉल करा किंवा ${site.emails.sales} वर ईमेल करा.`,
    summary: 'कृपया चिन्हांकित फील्ड तपासा.',
    errName: 'कृपया तुमचे नाव लिहा.',
    errPhone: 'कृपया किमान 7 अंकांचा फोन नंबर लिहा.',
    errEmail: 'कृपया योग्य ईमेल पत्ता लिहा, किंवा हे रिकामे ठेवा.',
    errReq: 'कृपया एक गरज निवडा.',
    privacy: 'तुमची माहिती फक्त तुमच्या चौकशीला उत्तर देण्यासाठी वापरली जाते.',
    privacyLink: 'गोपनीयता धोरण',
    another: 'आणखी एक चौकशी पाठवा',
    trustAlt: 'डंपसाइटवर जुन्या कचऱ्यावर प्रक्रिया करणारी बायो-मायनिंग ट्रॉमेल लाइन',
    whatsapp: 'WhatsApp',
  },
}[lang];

const home = lang === 'en' ? '/' : `/${lang}/`;
const alternates = { en: '/contact-us', hi: '/hi/contact-us', mr: '/mr/contact-us' };
const endpoint = site.enquiryEndpoint as string;
const responseTime = site.responseTime[lang];
const phoneLabels = site.phoneLabels;
const whatsappHref = site.whatsapp ? `https://wa.me/${site.whatsapp.replace(/\D/g, '')}` : '';
const projects = figures[0];
const trustLabel = { en: figures[0].label, hi: 'भारत भर में बायो-माइनिंग परियोजनाएँ', mr: 'भारतभर बायो-मायनिंग प्रकल्प' }[lang];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: copy.title,
    url: `${site.url}${alternates[lang]}`,
  },
];
---

<Base title={copy.title} description={copy.description} lang={lang} alternates={alternates} schema={schema}>
  <section class="chero">
    <div class="container chero__inner">
      <nav class="chero__crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href={home}>{copy.crumbs[0]}</a></li>
          <li><span aria-current="page">{copy.crumbs[1]}</span></li>
        </ol>
      </nav>
      <p class="eyebrow" data-reveal>{copy.eyebrow}</p>
      <h1 class="h1 chero__title" data-reveal style="--d: 1" set:html={copy.heroTitle} />
      <p class="lead chero__lead" data-reveal style="--d: 2">{copy.lead}</p>
      <ul class="quick">
        <li data-reveal style="--d: 3">
          <a class="quick__tile" href={telHref(site.phones[0])}>
            <span class="quick__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"></path></svg>
            </span>
            <span class="quick__label">{copy.quick[0]}</span>
            <span class="quick__value tabular">{site.phones[0]}</span>
          </a>
        </li>
        <li data-reveal style="--d: 4">
          <a class="quick__tile" href={`mailto:${site.emails.sales}`}>
            <span class="quick__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
            </span>
            <span class="quick__label">{copy.quick[1]}</span>
            <span class="quick__value">{site.emails.sales}</span>
          </a>
        </li>
        <li data-reveal style="--d: 5">
          <a class="quick__tile" href={site.mapUrl} target="_blank" rel="noopener">
            <span class="quick__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
            </span>
            <span class="quick__label">{copy.quick[2]}</span>
            <span class="quick__value">Rajarampuri, {site.address.city}</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="contact-wrap">
    <div class="container contact">
      <div class="form-card" id="enquiry" data-reveal>
        <div class="form-card__head">
          <span class="form-card__icon"><Icon name="consult" size={26} /></span>
          <div>
            <h2 class="h3">{copy.formTitle}</h2>
            <p class="muted form-card__hours">{copy.hours}</p>
            {responseTime && <p class="form-card__reply">{responseTime}</p>}
          </div>
        </div>
        <form
          class="form"
          data-enquiry
          data-endpoint={endpoint}
          data-lang={lang}
          data-sending={copy.sending}
          data-error={copy.error}
          data-summary={copy.summary}
          novalidate
        >
          <p class="form__summary" role="alert" data-summary-box hidden></p>
          <div class="field">
            <label for="f-name">{copy.name} <span aria-hidden="true">*</span></label>
            <input id="f-name" name="name" type="text" autocomplete="name" maxlength="120" required aria-describedby="e-name" />
            <p class="field__error" id="e-name" data-error-for="name" data-msg={copy.errName}></p>
          </div>
          <div class="field">
            <label for="f-org">{copy.org}</label>
            <input id="f-org" name="organisation" type="text" autocomplete="organization" maxlength="160" />
          </div>
          <div class="field">
            <label for="f-phone">{copy.phone} <span aria-hidden="true">*</span></label>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" required aria-describedby="e-phone" />
            <p class="field__error" id="e-phone" data-error-for="phone" data-msg={copy.errPhone}></p>
          </div>
          <div class="field">
            <label for="f-email">{copy.email}</label>
            <input id="f-email" name="email" type="email" autocomplete="email" maxlength="160" aria-describedby="e-email" />
            <p class="field__error" id="e-email" data-error-for="email" data-msg={copy.errEmail}></p>
          </div>
          <div class="field">
            <label for="f-city">{copy.city}</label>
            <input id="f-city" name="city" type="text" autocomplete="address-level2" maxlength="120" />
          </div>
          <div class="field">
            <label for="f-capacity">{copy.capacity}</label>
            <input id="f-capacity" name="capacity" type="text" inputmode="decimal" maxlength="80" aria-describedby="h-capacity" />
            <p class="field__hint" id="h-capacity">{copy.capacityHint}</p>
          </div>
          <div class="field field--full">
            <label for="f-req">{copy.requirement} <span aria-hidden="true">*</span></label>
            <select id="f-req" name="requirement" required aria-describedby="e-req">
              <option value="">{copy.choose}</option>
              <optgroup label={copy.servicesGroup}>
                {services.map((s) => <option value={s.name}>{localName(lang, s.slug, s.name)}</option>)}
              </optgroup>
              <optgroup label={copy.machineryGroup}>
                {products.map((p) => <option value={p.name}>{localName(lang, p.slug, p.name)}</option>)}
              </optgroup>
              <option value="Other">{copy.other}</option>
            </select>
            <p class="field__error" id="e-req" data-error-for="requirement" data-msg={copy.errReq}></p>
          </div>
          <div class="field field--full">
            <label for="f-msg">{copy.message}</label>
            <textarea id="f-msg" name="message" rows="5" maxlength="4000" placeholder={copy.messagePlaceholder}></textarea>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="f-website">Website</label>
            <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="form__foot field--full">
            <button class="btn btn--accent form__submit" type="submit" data-submit>
              <span class="form__spinner" aria-hidden="true"></span>
              <span data-submit-label>{copy.send}</span> <span class="arrow" aria-hidden="true">→</span>
            </button>
            <p class="form__note">
              <span>* {copy.required}.</span>
              <span>{copy.privacy} <a href="/privacy">{copy.privacyLink}</a>.</span>
            </p>
          </div>
          <p class="form__status" role="status" aria-live="polite" data-status></p>
        </form>
        <div class="form__done" data-done hidden tabindex="-1">
          <span class="form__done-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
          </span>
          <p class="h3">{copy.successTitle}</p>
          <p class="muted">{copy.successText}</p>
          <button type="button" class="link-arrow form__again" data-again>{copy.another} <span class="arrow">→</span></button>
        </div>
      </div>

      <aside class="details" data-reveal style="--d: 1">
        <figure class="trust">
          <Image src={trustPhoto} alt={copy.trustAlt} widths={[400, 640, 900]} sizes="(min-width: 1000px) 420px, 92vw" loading="lazy" />
          <figcaption>
            <span class="trust__num tabular">{projects.value}</span>
            <span class="trust__label">{trustLabel}</span>
          </figcaption>
        </figure>
        <div class="details__block">
          <p class="details__label">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"></path></svg>
            {copy.call}
          </p>
          <ul class="details__phones">
            {
              site.phones.map((p, i) => (
                <li>
                  {phoneLabels[i] && <span class="details__phone-label">{phoneLabels[i]}</span>}
                  <a href={telHref(p)}>{p}</a>
                </li>
              ))
            }
          </ul>
          {
            whatsappHref && (
              <a class="details__wa" href={whatsappHref} target="_blank" rel="noopener">
                {copy.whatsapp} <span class="arrow">↗</span>
              </a>
            )
          }
        </div>
        <div class="details__block">
          <p class="details__label">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
            {copy.emailLabel}
          </p>
          <ul class="details__mail">
            {
              Object.values(site.emails).map((e) => (
                <li>
                  <a href={`mailto:${e}`}>{e}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="details__block">
          <p class="details__label">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
            {copy.office}
          </p>
          <address>
            <strong>{site.name}</strong>
            {site.address.lines.map((l) => <span>{l}</span>)}
            <span>{site.address.city} {site.address.postcode}</span>
            <span>{site.address.region}, {site.address.country}</span>
          </address>
          <a class="link-arrow" href={site.mapUrl} target="_blank" rel="noopener">{copy.map} <span class="arrow">↗</span></a>
        </div>
        <div class="details__block">
          <p class="details__label">
