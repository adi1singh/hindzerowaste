---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you were looking for could not be found.">
  <section class="section">
    <div class="container nf">
      <p class="eyebrow">404</p>
      <h1 class="display nf__title">This page has been <em>recovered</em>.</h1>
      <p class="lead">The page you were looking for has moved or no longer exists. Try one of these instead.</p>
      <div class="btn-row">
        <a class="btn" href="/">Home <span class="arrow">→</span></a>
        <a class="link-arrow" href="/product">Machinery <span class="arrow">→</span></a>
        <a class="link-arrow" href="/services">Services <span class="arrow">→</span></a>
        <a class="link-arrow" href="/contact-us">Contact <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-height: 50vh;
    justify-content: center;
  }

  .nf__title {
    max-width: 12em;
  }
</style>
