---

import Base from '../layouts/Base.astro';
import IndexHero from '../components/IndexHero.astro';
import ProductCard from '../components/ProductCard.astro';

import CtaBand from '../components/CtaBand.astro';
import { products } from '../data/products';
import { site } from '../data/site';

import tileA from '../assets/photos/vertical-baler-2.jpg';
import tileB from '../assets/photos/disc-separator.jpg';
import tileC from '../assets/photos/horizontal-baler.jpg';

const categories = [...new Set(products.map((p) => p.category))];

---

<Base
  title="Waste Processing Machinery | Trommels, Separators, Shredders, Balers"
  description="Waste-processing machinery engineered and built in-house by Hind Zero Waste: rotary trommels, air density and disc separators, shredders, balers, composters, conveyors, PEB sheds and sewer suction vehicles."
>
  <IndexHero
    eyebrow="Machinery"
    title="Machines built for the <em>hardest</em> waste."
    lead="Every machine is engineered and fabricated in-house for continuous 24×7 duty, then configured to the waste, throughput and layout of your plant."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Machinery' }]}
    images={[
      { src: tileA, alt: 'Vertical hydraulic baler with power pack' },
      { src: tileB, alt: 'Disc separator with red screening discs' },
      { src: tileC, alt: 'Horizontal hydraulic baling machine' },
    ]}
    stats={[
      { value: products.length, label: 'Machine families' },
      { value: categories.length, label: 'Categories' },
      { value: 300, suffix: '+', label: 'Balers supplied' },
    ]}
  >
    <a class="btn btn--accent" href="#catalogue">Browse the range <span class="arrow">↓</span></a>
    <a class="btn btn--ghost" href={site.downloads.brochure} target="_blank" rel="noopener">Download brochure <span class="arrow">↗</span></a>
  </IndexHero>

  <section class="section bg-paper" id="catalogue">
    <div class="container">
      <div class="cat-head" data-reveal>
        <div>
          <p class="eyebrow">The range</p>
          <h2 class="h2">Explore our <em>machinery</em></h2>
        </div>

      </div>

      <div class="catalogue-grid">
        {products.map((product, i) => <div data-reveal style={`--d:${i % 3}`}><ProductCard product={product} index={i} /></div>)}
      </div>
    </div>
  </section>

  <section class="section--tight bg-sage">
    <div class="container brochure" data-reveal>
      <div>
        <p class="eyebrow">Brochure</p>
        <h2 class="h3 brochure__title">Full technical data for every model, in one document.</h2>
      </div>
      <div class="btn-row">
        <a class="btn" href={site.downloads.brochure} target="_blank" rel="noopener">Download brochure <span class="arrow">↗</span></a>
        <a class="link-arrow" href={site.downloads.profile} target="_blank" rel="noopener">Company profile <span class="arrow">↗</span></a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .cat-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 36px;
  }

  .cat-head .h2 {
    margin-top: 14px;
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    list-style: none;
  }

  .cat-grid--single {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: stretch;
  }

  .cat-note {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 22px;
    padding: 12px 8px 12px 24px;
  }

  .cat-note__lead {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    line-height: 1.3;
    color: var(--ink);
  }

  .cat-note__apps {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .cat-note__apps li {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--sage);
    color: var(--green-ink);
    font-size: 14px;
    font-weight: 600;
  }

  .brochure {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
  }

  .brochure__title {
    margin-top: 16px;
    max-width: 18em;
  }

  @media (max-width: 1000px) {
    .cat-grid,
    .cat-grid--single {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .cat-grid,
    .cat-grid--single {
      grid-template-columns: minmax(0, 1fr);
    }

    .cat-note {
      padding: 0;
    }
  }
  .catalogue-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  @media(max-width: 1000px) { .catalogue-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media(max-width: 600px) { .catalogue-grid { grid-template-columns: minmax(0,1fr); } }
</style>
