---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProductCard from '../components/ProductCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { products } from '../data/products';
import { site } from '../data/site';

const categories = [...new Set(products.map((p) => p.category))];
---

<Base
  title="Waste Processing Machinery | Trommels, Separators, Shredders, Balers"
  description="Waste-processing machinery engineered and built in-house by Hind Zero Waste: rotary trommels, air density and disc separators, shredders, balers, composters, conveyors, PEB sheds and sewer suction vehicles."
>
  <PageHero
    eyebrow="Machinery"
    title="Machines built for the <em>hardest</em> waste."
    lead="Every machine is engineered and fabricated in-house for continuous 24×7 duty, and configured to the waste, throughput and layout of your plant."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Machinery' }]}
  >
    <nav class="cats" aria-label="Categories">
      {
        categories.map((c) => (
          <a href={`#${c.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
            {c} <span class="tabular">{products.filter((p) => p.category === c).length}</span>
          </a>
        ))
      }
    </nav>
  </PageHero>

  {
    categories.map((c, ci) => (
      <section class:list={['cat', ci % 2 === 0 ? 'bg-white' : 'bg-paper']} id={c.toLowerCase().replace(/[^a-z]+/g, '-')}>
        <div class="container cat__inner">
          <div class="cat__head" data-reveal>
            <p class="cat__num tabular">{String(ci + 1).padStart(2, '0')}</p>
            <h2 class="h3">{c}</h2>
          </div>
          <ul class="cat__grid">
            {products
              .filter((p) => p.category === c)
              .map((p) => (
                <li data-reveal>
                  <ProductCard product={p} />
                </li>
              ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="section--tight bg-paper-2">
    <div class="container brochure">
      <div>
        <p class="eyebrow">Brochure</p>
        <h2 class="h3 brochure__title">Full technical data for every model, in one document.</h2>
      </div>
      <div class="btn-row">
        <a class="btn" href={site.downloads.brochure} target="_blank" rel="noopener">Download brochure <span class="arrow">↗</span></a>
        <a class="link-arrow" href={site.downloads.profile} target="_blank" rel="noopener">Company profile <span class="arrow">↗</span></a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(32px, 4vw, 48px);
  }

  .cats a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease);
  }

  .cats a span {
    color: var(--muted);
    font-size: 12px;
  }

  .cats a:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .cats a:hover span {
    color: var(--muted-on-dark);
  }

  .cat {
    padding-block: clamp(56px, 7vw, 96px);
  }

  .cat__inner {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 32px 48px;
  }

  .cat__head {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    align-self: start;
    border-top: 1px solid var(--line-strong);
    padding-top: 20px;
  }

  .cat__num {
    font-family: var(--serif);
    font-size: 1.4rem;
    color: var(--navy);
    margin-bottom: 8px;
  }

  .cat__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 32px;
    list-style: none;
  }

  .brochure {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
  }

  .brochure__title {
    margin-top: 16px;
    max-width: 18em;
  }

  @media (max-width: 900px) {
    .cat__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .cat__head {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .cat__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
