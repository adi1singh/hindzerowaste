---

import Base from '../layouts/Base.astro';
import IndexHero from '../components/IndexHero.astro';
import ProductCard from '../components/ProductCard.astro';

import CtaBand from '../components/CtaBand.astro';
import { products } from '../data/products';
import { site } from '../data/site';

import tileA from '../assets/photos/vertical-baler-2.jpg';
import tileB from '../assets/photos/disc-separator.jpg';
import tileC from '../assets/photos/horizontal-baler.jpg';

const categories = [...new Set(products.map((p) => p.category))];
const catKey = (c: string) => c.toLowerCase().replace(/[^a-z]+/g, '-');
const intro: Record<string, string> = {
  'Screening & separation': 'Trommels, air density and disc separators that split waste into clean fractions.',
  'Size reduction': 'Wet and dry shredders, single- and twin-shaft, from 100 kg/h to 20 TPH.',
  Compaction: 'Vertical and horizontal balers that press recyclables into saleable bales.',
  'Organic waste': 'On-site composting, from 50 kg a day to 20 tonnes.',
  'Material handling': 'Belt, chain, screw and inclined conveyors that tie a line together.',
  Infrastructure: 'Pre-engineered steel sheds sized around the machinery they house.',
  Vehicles: 'Truck-mounted vacuum tankers for sewers, septic tanks and drains.',
};

---

<Base
  title="Waste Processing Machinery | Trommels, Separators, Shredders, Balers"
  description="Waste-processing machinery engineered and built in-house by Hind Zero Waste: rotary trommels, air density and disc separators, shredders, balers, composters, conveyors, PEB sheds and sewer suction vehicles."
>
  <IndexHero
    tone="navy"
    eyebrow="Machinery"
    title="Machines built for the <em>hardest</em> waste."
    lead="Every machine is engineered and fabricated in-house for continuous 24×7 duty, then configured to the waste, throughput and layout of your plant."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Machinery' }]}
    images={[
      { src: tileA, alt: 'Vertical hydraulic baler with power pack' },
      { src: tileB, alt: 'Disc separator with red screening discs' },
      { src: tileC, alt: 'Horizontal hydraulic baling machine' },
    ]}
    stats={[
      { value: products.length, label: 'Machine families' },
      { value: categories.length, label: 'Categories' },
      { value: 300, suffix: '+', label: 'Balers supplied' },
    ]}
  >
    <a class="btn btn--accent" href="#catalogue">Browse the range <span class="arrow">↓</span></a>
    <a class="btn btn--ghost" href={site.downloads.brochure} target="_blank" rel="noopener">Download brochure <span class="arrow">↗</span></a>
  </IndexHero>

  <section class="section bg-paper" id="catalogue">
    <div class="container">
      <div class="cat-head" data-reveal>
        <div>
          <p class="eyebrow">The range</p>
          <h2 class="h2">Explore our <em>machinery</em></h2>
        </div>
        <p class="muted cat-head__note">{products.length} machine families across {categories.length} categories, each configured to your waste, throughput and site.</p>
      </div>

      <div class="range">
        <nav class="range__index" aria-label="Machinery categories" data-range-index>
          <ol>
            {
              categories.map((c, i) => (
                <li>
                  <a href={`#${catKey(c)}`} data-range-link={catKey(c)} class:list={{ 'is-active': i === 0 }}>
                    <span class="range__no tabular">{String(i + 1).padStart(2, '0')}</span>
                    <span class="range__name">{c}</span>
                    <span class="range__count tabular">{products.filter((p) => p.category === c).length}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="range__groups">
          {
            categories.map((c, i) => {
              const items = products.filter((p) => p.category === c);
              return (
                <section class="range__group" id={catKey(c)} data-range-group aria-labelledby={`${catKey(c)}-title`}>
                  <header class="range__head" data-reveal>
                    <span class="range__big tabular" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    <div class="range__text">
                      <h3 class="range__title" id={`${catKey(c)}-title`}>{c}</h3>
                      <p class="range__intro">{intro[c]}</p>
                    </div>
                    <span class="range__qty tabular">{items.length} {items.length === 1 ? 'machine' : 'machines'}</span>
                  </header>
                  <ul class:list={['range__cards', { 'range__cards--one': items.length === 1 }]}>
                    {items.map((p, j) => (
                      <li data-reveal style={`--d:${j}`}>
                        <ProductCard product={p} />
                      </li>
                    ))}
                  </ul>
                </section>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>

  <section class="brochure on-dark">
    <div class="container brochure__inner" data-reveal>
      <div>
        <p class="eyebrow">Brochure</p>
        <h2 class="h2 brochure__title">Full technical data for every model, <em>in one document</em>.</h2>
      </div>
      <div class="brochure__side">
        <p>Capacities, dimensions and configurations for the whole range, ready to share with your engineers.</p>
        <div class="btn-row">
          <a class="btn btn--accent" href={site.downloads.brochure} target="_blank" rel="noopener">Download brochure <span class="arrow">↗</span></a>
          <a class="link-arrow" href={site.downloads.profile} target="_blank" rel="noopener">Company profile <span class="arrow">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  // Highlight the category in the index that is currently on screen.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-range-link]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-range-group]')];
  if (links.length && 'IntersectionObserver' in window) {
    const setActive = (id: string) => {
      links.forEach((l) => l.classList.toggle('is-active', l.dataset.rangeLink === id));
      const active = links.find((l) => l.dataset.rangeLink === id);
      // On phones the index is a sideways strip; keep the active entry in view.
      if (active && window.matchMedia('(max-width: 1000px)').matches) {
        active.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      }
    };
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-35% 0px -55% 0px' },
    );
    groups.forEach((g) => io.observe(g));
  }
</script>

<style>
  .cat-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(36px, 5vw, 64px);
  }

  .cat-head .h2 {
    margin-top: 14px;
  }

  .cat-head__note {
    max-width: 30em;
  }

  /* Editorial catalogue: a sticky index on the left, categories on the right. */
  .range {
    display: grid;
    grid-template-columns: minmax(220px, 3fr) minmax(0, 9fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }

  .range__index {
    position: sticky;
    top: calc(var(--header-h) + 28px);
  }

  .range__index ol {
    display: grid;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .range__index a {
    position: relative;
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
    padding: 14px 4px 14px 14px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    text-decoration: none;
    transition:
      color 0.3s var(--ease),
      background-color 0.3s var(--ease),
      padding-left 0.35s var(--ease-out);
  }

  .range__index a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 10px;
    width: 3px;
    border-radius: 3px;
    background: var(--saffron);
    transform: scaleY(0);
    transition: transform 0.35s var(--ease-out);
  }

  .range__index a:hover {
    color: var(--ink);
    background: var(--white);
  }

  .range__index a.is-active {
    color: var(--ink);
    padding-left: 20px;
    background: var(--white);
  }

  .range__index a.is-active::before {
    transform: scaleY(1);
  }

  .range__no {
    font: 700 12px/1 var(--sans);
    letter-spacing: 0.08em;
    color: var(--saffron-ink);
  }

  .range__name {
    font: 600 15px/1.3 var(--sans);
  }

  .range__count {
    display: grid;
    place-items: center;
    min-width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--paper-2);
    font: 700 12px/1 var(--sans);
    color: var(--ink);
  }

  .range__index a.is-active .range__count {
    background: var(--saffron);
    color: var(--white);
  }

  .range__groups {
    display: grid;
    gap: clamp(56px, 7vw, 96px);
  }

  .range__group {
    scroll-margin-top: calc(var(--header-h) + 28px);
  }

  /* Each category opens with a bold, boxed heading so the grouping is obvious. */
  .range__head {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 22px;
    padding: 18px 22px 18px 18px;
    border-radius: 14px;
    background: linear-gradient(120deg, #7a5236 0%, #5e3d27 60%, #4a2f1e 100%);
    border-left: 5px solid var(--saffron-2);
    box-shadow: 0 16px 34px -22px rgba(74, 47, 30, 0.7);
  }

  .range__big {
    display: grid;
    place-items: center;
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: #f6e7d7;
    color: #5e3d27;
    font: 800 20px/1 var(--sans);
    letter-spacing: -0.02em;
  }

  .range__text {
    flex: 1;
    min-width: 0;
  }

  .range__title {
    font: 750 clamp(1.35rem, 2vw, 1.7rem) / 1.2 var(--sans);
    letter-spacing: -0.02em;
    color: var(--white);
  }

  .range__intro {
    margin-top: 4px;
    font-size: 15.5px;
    line-height: 1.5;
    color: #f0dccb;
  }

  .range__qty {
    flex: none;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    font: 700 13px/1 var(--sans);
    color: var(--white);
  }

  .range__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    list-style: none;
  }

  /* A single machine gets a wide, horizontal card. */
  .range__cards--one :global(.pcard) {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
  }

  .range__cards--one {
    grid-template-columns: minmax(0, 1fr);
  }

  .range__cards--one :global(.pcard__media) {
    height: 100%;
    min-height: 280px;
    aspect-ratio: auto;
  }

  .range__cards--one :global(.pcard__body) {
    justify-content: center;
  }

  /* Brochure band */
  .brochure {
    position: relative;
    overflow: hidden;
    padding-block: clamp(64px, 8vw, 104px);
    background: radial-gradient(120% 140% at 0% 0%, #3a312b 0%, #1f1a17 55%, #141110 100%);
    color: #e8e0d6;
  }

  .brochure::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(80% 90% at 80% 50%, #000, transparent);
    mask-image: radial-gradient(80% 90% at 80% 50%, #000, transparent);
    pointer-events: none;
  }

  .brochure__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 32px 64px;
    align-items: end;
  }

  .brochure__title {
    margin-top: 16px;
    max-width: 14em;
    color: var(--white);
  }

  .brochure__side {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .brochure__side p {
    font-size: 17px;
    line-height: 1.65;
    color: #d6ccc1;
  }

  @media (max-width: 1000px) {
    .range {
      grid-template-columns: minmax(0, 1fr);
    }

    /* The index becomes a sticky sideways strip under the header. */
    .range__index {
      z-index: 5;
      top: var(--header-h);
      margin-inline: calc(-1 * var(--gutter));
      padding: 10px var(--gutter);
      background: color-mix(in srgb, var(--paper) 92%, transparent);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--line);
    }

    .range__index ol {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      border: 0;
      scrollbar-width: none;
    }

    .range__index ol::-webkit-scrollbar {
      display: none;
    }

    .range__index a,
    .range__index a.is-active {
      display: inline-flex;
      gap: 8px;
      padding: 9px 12px;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      white-space: nowrap;
      background: var(--white);
    }

    .range__index a::before,
    .range__no {
      display: none;
    }

    .range__index a.is-active {
      border-color: var(--saffron);
      background: var(--saffron);
      color: var(--white);
    }

    .range__index a.is-active .range__count {
      background: rgba(255, 255, 255, 0.2);
    }

    .brochure__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .range__cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .range__cards--one :global(.pcard) {
      display: flex;
    }

    .range__cards--one :global(.pcard__media) {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    .range__head {
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 12px 14px;
      padding: 16px;
    }

    .range__big {
      width: 44px;
      height: 44px;
      font-size: 16px;
    }

    .range__text {
      flex-basis: calc(100% - 60px);
    }

    .range__qty {
      margin-left: 58px;
    }
  }
</style>
