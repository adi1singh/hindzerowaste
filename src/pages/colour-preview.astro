---
// Internal page for choosing a colour direction. Not linked or indexed.
const options = [
  { key: '', name: 'Current: Navy', note: 'Navy from the HIND wordmark with a saffron accent.', swatches: ['#083984', '#0b1525', '#f39a2f', '#f6f3ec'] },
  { key: 'forest', name: 'A. Forest green', note: 'Deep green with the lime from the logo. Environmental and premium.', swatches: ['#1d5a3a', '#0e1f17', '#c3d32c', '#f6f3ec'] },
  { key: 'clay', name: 'B. Earth / clay', note: 'Charcoal with terracotta. Industrial and grounded.', swatches: ['#2e2a27', '#1d1a18', '#c8643b', '#f5efe6'] },
  { key: 'ink', name: 'C. Ink & saffron', note: 'Near-black with saffron. Bold, editorial, luxurious.', swatches: ['#141414', '#0b0b0b', '#f39a2f', '#f6f3ec'] },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Colour Options</title>
    <style>
      body { margin: 0; padding: 32px 16px 64px; background: #ece9e2; color: #111; font: 16px/1.5 system-ui, sans-serif; }
      h1 { margin: 0 0 6px; font-size: 28px; }
      .intro { margin: 0 0 28px; color: #555; max-width: 60em; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 620px), 1fr)); gap: 28px; }
      .card { background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 10px 30px -18px rgba(0,0,0,.3); }
      .head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; align-items: center; padding: 18px 20px; }
      .head h2 { margin: 0; font-size: 20px; }
      .head p { margin: 2px 0 0; color: #555; font-size: 14px; }
      .sw { display: flex; gap: 6px; }
      .sw span { width: 28px; height: 28px; border-radius: 50%; border: 1px solid rgba(0,0,0,.12); }
      .frame { position: relative; height: 560px; overflow: hidden; border-top: 1px solid #eee; }
      .frame iframe { position: absolute; top: 0; left: 0; width: 1440px; height: 1400px; border: 0; transform: scale(var(--s)); transform-origin: 0 0; }
      .open { display: block; padding: 14px 20px; font-weight: 600; color: #111; border-top: 1px solid #eee; text-decoration: none; }
      .open:hover { background: #f6f6f6; }
    </style>
  </head>
  <body>
    <h1>Colour options</h1>
    <p class="intro">The same home page in each colour direction; the logo stays the same. Scroll inside each preview, or open one full-size to click around the whole site in that colour.</p>
    <div class="grid">
      {options.map((o) => (
        <section class="card">
          <div class="head">
            <div><h2>{o.name}</h2><p>{o.note}</p></div>
            <div class="sw">{o.swatches.map((c) => <span style={`background:${c}`} />)}</div>
          </div>
          <div class="frame"><iframe src={`/?theme=${o.key}`} title={o.name} loading="lazy" /></div>
          <a class="open" href={`/?theme=${o.key}`} target="_blank" rel="noopener">Open full site in this colour ↗</a>
        </section>
      ))}
    </div>
    <script is:inline>
      function fit() {
        document.querySelectorAll('.frame').forEach(function (f) {
          f.style.setProperty('--s', f.clientWidth / 1440);
          f.style.height = Math.round(f.clientWidth / 1440 * 1400) + 'px';
        });
      }
      addEventListener('resize', fit); fit();
    </script>
  </body>
</html>
