---
// Shared featured projects with on-entry number animation and preserved units.
import { featuredProjects, type Project } from '../data/projects';
import { featuredProjectsLocal, statusLabels } from '../i18n/content';
import Count from './Count.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const projects: Project[] =
  lang === 'en'
    ? featuredProjects
    : featuredProjects.map((p, i) => ({ ...p, ...(featuredProjectsLocal[lang][i] as Partial<Project>) }));
---

<ul class="pgrid">
  {
    projects.map((p, i) => (
      <li class="pgrid__card" data-reveal style={`--d:${i % 3}`}>
        <div class="pgrid__top">
          <span class="pgrid__idx tabular">{String(i + 1).padStart(2, '0')}</span>
          <span class:list={['pgrid__status', `is-${p.status.toLowerCase()}`]}>{statusLabels[lang][p.status]}</span>
        </div>
        <p class="pgrid__num tabular"><Count {...p.count} /></p>
        <h3 class="pgrid__client">{p.client}</h3>
        <p class="pgrid__loc">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle>
          </svg>
          {p.location}
        </p>
        <p class="pgrid__scope">
          {p.scope}
          {p.note && <span class="pgrid__note">{p.note}</span>}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .pgrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    list-style: none;
  }

  .pgrid__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
    padding: 26px 28px 30px;
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, rgba(246, 243, 236, 0.09), rgba(246, 243, 236, 0.03) 60%);
    border: 1px solid rgba(246, 243, 236, 0.18);
    transition:
      transform 0.45s var(--ease-out),
      background-color 0.45s var(--ease-out),
      border-color 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out);
  }

  /* Clay rule along the top that runs the full width on hover. */
  .pgrid__card::before {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    width: 64px;
    height: 4px;
    background: var(--saffron-2);
    transition: width 0.5s var(--ease-out);
  }

  .pgrid__card:hover {
    transform: translateY(-8px);
    border-color: rgba(224, 138, 98, 0.6);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.7);
  }

  .pgrid__card:hover::before {
    width: 100%;
  }

  .pgrid__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }

  .pgrid__idx {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--muted-on-dark);
  }

  .pgrid__num {
    font: 800 clamp(2.2rem, 3.2vw, 2.9rem) / 1.05 var(--sans);
    letter-spacing: -0.03em;
    color: var(--saffron-2);
  }

  .pgrid__client {
    margin-top: 4px;
    font: 700 clamp(1.25rem, 1.55vw, 1.45rem) / 1.3 var(--sans);
    letter-spacing: -0.01em;
    color: var(--white);
    text-wrap: balance;
  }

  .pgrid__loc {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 16px;
    font-weight: 600;
    color: #f0c3a8;
  }

  .pgrid__loc svg {
    flex: none;
    margin-top: 3px;
  }

  .pgrid__scope {
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--line-on-dark);
    font-size: 16px;
    line-height: 1.55;
    color: #ddd2c6;
  }

  .pgrid__note {
    display: block;
    margin-top: 4px;
    font-weight: 650;
    color: var(--white);
  }

  .pgrid__status {
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: rgba(132, 187, 57, 0.18);
    color: #c2e597;
  }

  .pgrid__status.is-ongoing {
    background: rgba(224, 138, 98, 0.2);
    color: #f3b896;
  }

  @media (max-width: 1100px) {
    .pgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .pgrid {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    .pgrid__card {
      padding: 22px 22px 24px;
    }
  }

  .pgrid__card { border-top: 3px solid var(--saffron-2); background: linear-gradient(145deg, #e08a621c, #ffffff08); }
  .pgrid__card:nth-child(even) { border-top-color: #a6bd80; }
  .pgrid__card::before { top: auto; bottom: 0; height: 3px; }
  @media (prefers-reduced-motion: no-preference) {
    .pgrid__card.is-visible .pgrid__num { animation: project-value .9s var(--ease-out) both; animation-delay: calc(var(--d, 0) * .12s); }
    .pgrid__card.is-visible::before { animation: project-rule 1.2s var(--ease-out) both; animation-delay: calc(var(--d, 0) * .15s); }
  }
  @keyframes project-value { from { opacity: 0; transform: translateY(16px) scale(.94); } to { opacity: 1; transform: none; } }
  @keyframes project-rule { from { width: 0; } to { width: 100%; } }

  .pgrid__card { background: var(--white); border: 1px solid var(--line); border-top: 3px solid var(--saffron); box-shadow: 0 8px 25px -20px rgba(var(--shade), .35); }
  .pgrid__card:hover { border-color: color-mix(in srgb, var(--saffron) 35%, transparent); box-shadow: var(--shadow-md); }
  .pgrid__idx { color: var(--muted); }
  .pgrid__num { color: var(--saffron-ink); }
  .pgrid__client, .pgrid__note { color: var(--ink); }
  .pgrid__loc { color: var(--green-ink); }
  .pgrid__scope { border-color: var(--line); color: var(--muted); }
  .pgrid__status { --status-glow: 105, 145, 65; background: #edf3e5; color: #3d5b29; border: 1px solid #cfddc0; box-shadow: 0 0 14px 2px rgba(var(--status-glow), .16); }
  .pgrid__status.is-ongoing { --status-glow: 190, 116, 66; background: #fff0e3; color: #87411d; border-color: #edcfb6; }
  .pgrid__status.is-commissioned { --status-glow: 62, 127, 143; background: #e9f4f7; color: #285e6b; border-color: #c4dee5; }
  @media (prefers-reduced-motion: no-preference) {
    .pgrid__card.is-visible .pgrid__status { animation: status-glow 3.8s ease-in-out infinite alternate; animation-delay: calc(var(--d, 0) * .5s); }
  }
  @keyframes status-glow { from { box-shadow: 0 0 10px 1px rgba(var(--status-glow), .12); } to { box-shadow: 0 0 18px 4px rgba(var(--status-glow), .23); } }


  .pgrid__card { background: radial-gradient(ellipse at top right, var(--tile-tint), transparent 85%), #fffaf2; }
</style>
