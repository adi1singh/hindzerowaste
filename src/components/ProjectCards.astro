---
// The six featured projects as cards (home and about pages). Figures are shown
// as written, not counted up, so the scale of each project reads immediately.
import { featuredProjects, type Project } from '../data/projects';
import { featuredProjectsLocal, statusLabels } from '../i18n/content';
import type { Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const projects: Project[] =
  lang === 'en'
    ? featuredProjects
    : featuredProjects.map((p, i) => ({ ...p, ...(featuredProjectsLocal[lang][i] as Partial<Project>) }));
---

<ul class="pgrid">
  {
    projects.map((p, i) => (
      <li class="pgrid__card" data-reveal style={`--d:${i % 3}`}>
        <div class="pgrid__top">
          <span class="pgrid__idx tabular">{String(i + 1).padStart(2, '0')}</span>
          <span class:list={['pgrid__status', `is-${p.status.toLowerCase()}`]}>{statusLabels[lang][p.status]}</span>
        </div>
        <p class="pgrid__num tabular">{p.scale}</p>
        <h3 class="pgrid__client">{p.client}</h3>
        <p class="pgrid__loc">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle>
          </svg>
          {p.location}
        </p>
        <p class="pgrid__scope">
          {p.scope}
          {p.note && <span class="pgrid__note">{p.note}</span>}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .pgrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    list-style: none;
  }

  .pgrid__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
    padding: 26px 28px 30px;
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, rgba(246, 243, 236, 0.09), rgba(246, 243, 236, 0.03) 60%);
    border: 1px solid rgba(246, 243, 236, 0.18);
    transition:
      transform 0.45s var(--ease-out),
      background-color 0.45s var(--ease-out),
      border-color 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out);
  }

  /* Clay rule along the top that runs the full width on hover. */
  .pgrid__card::before {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    width: 64px;
    height: 4px;
    background: var(--saffron-2);
    transition: width 0.5s var(--ease-out);
  }

  .pgrid__card:hover {
    transform: translateY(-8px);
    border-color: rgba(224, 138, 98, 0.6);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.7);
  }

  .pgrid__card:hover::before {
    width: 100%;
  }

  .pgrid__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }

  .pgrid__idx {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--muted-on-dark);
  }

  .pgrid__num {
    font: 800 clamp(2.2rem, 3.2vw, 2.9rem) / 1.05 var(--sans);
    letter-spacing: -0.03em;
    color: var(--saffron-2);
  }

  .pgrid__client {
    margin-top: 4px;
    font: 700 clamp(1.25rem, 1.55vw, 1.45rem) / 1.3 var(--sans);
    letter-spacing: -0.01em;
    color: var(--white);
    text-wrap: balance;
  }

  .pgrid__loc {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 16px;
    font-weight: 600;
    color: #f0c3a8;
  }

  .pgrid__loc svg {
    flex: none;
    margin-top: 3px;
  }

  .pgrid__scope {
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--line-on-dark);
    font-size: 16px;
    line-height: 1.55;
    color: #ddd2c6;
  }

  .pgrid__note {
    display: block;
    margin-top: 4px;
    font-weight: 650;
    color: var(--white);
  }

  .pgrid__status {
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: rgba(132, 187, 57, 0.18);
    color: #c2e597;
  }

  .pgrid__status.is-ongoing {
    background: rgba(224, 138, 98, 0.2);
    color: #f3b896;
  }

  @media (max-width: 1100px) {
    .pgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .pgrid {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    .pgrid__card {
      padding: 22px 22px 24px;
    }
  }
</style>
