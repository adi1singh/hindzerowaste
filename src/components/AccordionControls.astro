---
// "Expand all" / "Collapse all" for every <details> inside the element with data-accordion={target}.
// Sections also open one by one as they scroll into view.
import type { Lang } from '../i18n/ui';

interface Props {
  target: string;
  lang?: Lang;
}

const { target, lang = 'en' } = Astro.props;
const labels = {
  en: ['Expand all', 'Collapse all'],
  hi: ['सभी खोलें', 'सभी बंद करें'],
  mr: ['सर्व उघडा', 'सर्व बंद करा'],
}[lang];
---

<div class="acc-ctrl" data-accordion-controls={target}>
  <button type="button" class="acc-ctrl__btn" data-action="open">
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" fill="none"></path></svg>
    {labels[0]}
  </button>
  <button type="button" class="acc-ctrl__btn" data-action="close">
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10" stroke="currentColor" stroke-width="1.8" fill="none"></path></svg>
    {labels[1]}
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-accordion-controls]').forEach((ctrl) => {
    const root = document.querySelector<HTMLElement>(`[data-accordion="${ctrl.dataset.accordionControls}"]`);
    if (!root) return;
    const items = [...root.querySelectorAll<HTMLDetailsElement>('details')];
    const tiles = root.hasAttribute('data-tiles');
    // Tile grids open only on click; lists open one by one on scroll.
    let auto = !tiles;
    if (tiles)
      items.forEach((d) =>
        d.addEventListener('toggle', () => {
          if (d.open && 'touched' in d.dataset) d.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }),
      );

    ctrl.querySelectorAll<HTMLButtonElement>('[data-action]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const open = btn.dataset.action === 'open';
        items.forEach((d) => (d.open = open));
        // After "Collapse all", stop opening sections on scroll.
        if (!open) auto = false;
      }),
    );

    // Each section opens by itself as it scrolls into view, once, unless the
    // visitor has already opened or closed it by hand.
    items.forEach((d) =>
      d.querySelector('summary')?.addEventListener('click', () => (d.dataset.touched = '')),
    );
    if (!('IntersectionObserver' in window)) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const d = entry.target.closest('details') as HTMLDetailsElement;
          io.unobserve(entry.target);
          if (auto && !('touched' in d.dataset)) d.open = true;
        }
      },
      { rootMargin: '0px 0px -38% 0px' },
    );
    items.forEach((d) => {
      const summary = d.querySelector('summary');
      if (!d.open && summary) io.observe(summary);
    });
  });
</script>

<style>
  .acc-ctrl {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .acc-ctrl__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--white);
    color: var(--ink);
    font: 600 15px/1 var(--sans);
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .acc-ctrl__btn:hover {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--white);
    transform: translateY(-2px);
  }
</style>
