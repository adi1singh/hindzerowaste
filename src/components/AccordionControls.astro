---
// "Expand all" / "Collapse all" for every <details> inside the element with data-accordion={target}.
import type { Lang } from '../i18n/ui';

interface Props {
  target: string;
  lang?: Lang;
}

const { target, lang = 'en' } = Astro.props;
const labels = {
  en: ['Expand all', 'Collapse all'],
  hi: ['सभी खोलें', 'सभी बंद करें'],
  mr: ['सर्व उघडा', 'सर्व बंद करा'],
}[lang];
---

<div class="acc-ctrl" data-accordion-controls={target}>
  <button type="button" class="acc-ctrl__btn" data-action="open">
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" fill="none"></path></svg>
    {labels[0]}
  </button>
  <button type="button" class="acc-ctrl__btn" data-action="close">
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10" stroke="currentColor" stroke-width="1.8" fill="none"></path></svg>
    {labels[1]}
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-accordion-controls]').forEach((ctrl) => {
    const root = document.querySelector<HTMLElement>(`[data-accordion="${ctrl.dataset.accordionControls}"]`);
    if (!root) return;
    ctrl.querySelectorAll<HTMLButtonElement>('[data-action]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const open = btn.dataset.action === 'open';
        root.querySelectorAll('details').forEach((d) => (d.open = open));
      }),
    );
  });
</script>

<style>
  .acc-ctrl {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .acc-ctrl__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--white);
    color: var(--ink);
    font: 600 15px/1 var(--sans);
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .acc-ctrl__btn:hover {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--white);
    transform: translateY(-2px);
  }
</style>
