---
import { Image } from 'astro:assets';
import BrandLogo from './BrandLogo.astro';
import { site, telHref } from '../data/site';
import { products } from '../data/products';
import { services } from '../data/services';
import { consultancyCopy } from '../i18n/content';
import { languages, localName, localePath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates?: Partial<Record<Lang, string>>;
}

const { lang, alternates } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const home = localePath(lang, '/');
const aboutHref = localePath(lang, '/about-us');
const links = [
  { key: 'nav.about', href: aboutHref, current: path.endsWith('/about-us') },
  { key: 'nav.insights', href: '/waste-management-blogs', current: path === '/waste-management-blogs' },
  { key: 'nav.contact', href: localePath(lang, '/contact-us'), current: path.endsWith('/contact-us') },
] as const;

const productSlugs = new Set(products.map((p) => `/${p.slug}`));
const serviceSlugs = new Set(services.map((s) => `/${s.slug}`));
const isCurrent = (href: string) => (href.replace(/\/$/, '') || '/') === path;
const inMachinery = path === '/product' || productSlugs.has(path);
const inServices = path.endsWith('/services') || serviceSlugs.has(path);
const servicesHref = localePath(lang, '/services');

const langHref = (code: Lang) => alternates?.[code] ?? localePath(code, '/');
const chevron =
  '<svg width="12" height="12" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3.5l4 3.5 4-3.5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>';
---

<div class="topbar">
  <div class="container topbar__inner">
    <p class="topbar__creds">
      <span class="topbar__dot" aria-hidden="true"></span>{t(lang, 'top.credentials')}
    </p>
    <div class="topbar__right">
      <a class="topbar__phone" href={telHref(site.phones[0])}>
        <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"
          ></path></svg
        >
        {site.phones[0]}
      </a>
      <nav class="lang" aria-label={t(lang, 'lang.label')}>
        {
          (Object.keys(languages) as Lang[]).map((code) => (
            <a
              href={langHref(code)}
              lang={languages[code].htmlLang}
              hreflang={languages[code].htmlLang}
              aria-current={code === lang ? 'true' : undefined}
            >
              {languages[code].label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</div>

<header class="site-header" data-header>
  <div class="container bar">
    <a class="brand" href={home} aria-label={`${site.name}, home`}>
      <BrandLogo />
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav__list">
        <li class="nav__item" data-mega-item="mega-machinery">
          <a class="nav__link" href="/product" aria-current={inMachinery ? 'page' : undefined}>{t(lang, 'nav.machinery')}</a>
          <button
            class="nav__toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mega-machinery"
            aria-label={t(lang, 'nav.showMachinery')}
            data-mega-trigger
            set:html={chevron}
          />
        </li>
        <li class="nav__item" data-mega-item="mega-services">
          <a class="nav__link" href={servicesHref} aria-current={inServices ? 'page' : undefined}>{t(lang, 'nav.services')}</a>
          <button
            class="nav__toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mega-services"
            aria-label={t(lang, 'nav.showServices')}
            data-mega-trigger
            set:html={chevron}
          />
        </li>
        {
          links.map((l) => (
            <li class="nav__item">
              <a class="nav__link" href={l.href} aria-current={l.current ? 'page' : undefined}>
                {t(lang, l.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="bar__actions">
      <a class="btn btn--accent bar__quote" href={localePath(lang, '/contact-us') + '#enquiry'}>
        <span class="bar__quote-long">{t(lang, 'cta.quote')}</span>
        <span class="bar__quote-short">{t(lang, 'cta.quoteShort')}</span>
        <span class="arrow">→</span>
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
        <span class="menu-btn__label" data-open-label={t(lang, 'nav.menu')} data-close-label={t(lang, 'nav.close')}
          >{t(lang, 'nav.menu')}</span
        >
        <span class="menu-btn__icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="mega" id="mega-machinery" hidden data-mega>
    <div class="container mega__inner">
      <div class="mega__intro">
        <p class="eyebrow">{t(lang, 'nav.machinery')}</p>
        <p class="mega__text">{t(lang, 'nav.machineryIntro')}</p>
        <a class="link-arrow" href="/product">{t(lang, 'nav.allMachinery')} <span class="arrow">→</span></a>
      </div>
      <ul class="mega__grid">
        {
          products.map((p) => (
            <li>
              <a class="mega__item" href={`/${p.slug}`} aria-current={isCurrent(`/${p.slug}`) ? 'page' : undefined}>
                <span class="mega__thumb">
                  <Image src={p.images[0].src} alt="" width={112} height={84} loading="lazy" />
                </span>
                <span class="mega__label">
                  <span class="mega__name">{localName(lang, p.slug, p.name)}</span>
                  <span class="mega__meta">{p.range}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="mega" id="mega-services" hidden data-mega>
    <div class="container mega__inner">
      <div class="mega__intro">
        <p class="eyebrow">{t(lang, 'nav.services')}</p>
        <p class="mega__text">{t(lang, 'nav.servicesIntro')}</p>
        <a class="link-arrow" href={servicesHref}>{t(lang, 'nav.allServices')} <span class="arrow">→</span></a>
      </div>
      <ul class="mega__grid mega__grid--two">
        {
          services.map((s) => (
            <li>
              <a class="mega__item" href={`/${s.slug}`} aria-current={isCurrent(`/${s.slug}`) ? 'page' : undefined}>
                <span class="mega__thumb">
                  <Image src={s.images[0].src} alt="" width={112} height={84} loading="lazy" />
                </span>
                <span class="mega__label">
                  <span class="mega__name">{localName(lang, s.slug, s.name)}</span>
                  <span class="mega__meta">{s.range}</span>
                </span>
              </a>
            </li>
          ))
        }
        <li>
          <a class="mega__item mega__item--plain" href={`${servicesHref}#consultancy`}>
            <span class="mega__label">
              <span class="mega__name">{consultancyCopy[lang].name}</span>
            </span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden data-mobile-nav>
    <div class="container mobile-nav__inner">
      <ul class="mobile-nav__list">
        <li>
          <details>
            <summary>{t(lang, 'nav.machinery')}</summary>
            <ul>
              <li><a class="mobile-nav__all" href="/product">{t(lang, 'nav.allMachinery')} →</a></li>
              {
                products.map((p) => (
                  <li>
                    <a href={`/${p.slug}`}>{localName(lang, p.slug, p.name)}</a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>
        <li>
          <details>
            <summary>{t(lang, 'nav.services')}</summary>
            <ul>
              <li><a class="mobile-nav__all" href={servicesHref}>{t(lang, 'nav.allServices')} →</a></li>
              {
                services.map((s) => (
                  <li>
                    <a href={`/${s.slug}`}>{localName(lang, s.slug, s.name)}</a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>
        {
          links.map((l) => (
            <li>
              <a class="mobile-nav__top" href={l.href}>
                {t(lang, l.key)}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-nav__foot">
        <a class="btn btn--accent" href={localePath(lang, '/contact-us') + '#enquiry'}>{t(lang, 'cta.quote')} <span class="arrow">→</span></a>
        <div class="mobile-nav__phones">
          {site.phones.map((p) => <a href={telHref(p)}>{p}</a>)}
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const triggers = [...header.querySelectorAll<HTMLButtonElement>('[data-mega-trigger]')];
    const items = [...header.querySelectorAll<HTMLElement>('[data-mega-item]')];
    const panels = [...header.querySelectorAll<HTMLElement>('[data-mega]')];
    let closeTimer: number | undefined;

    const panelFor = (id: string) => document.getElementById(id);
    const triggerFor = (id: string) => triggers.find((t) => t.getAttribute('aria-controls') === id);

    const closeAll = () => {
      window.clearTimeout(closeTimer);
      triggers.forEach((t) => t.setAttribute('aria-expanded', 'false'));
      panels.forEach((p) => (p.hidden = true));
      items.forEach((i) => i.classList.remove('is-open'));
      header.classList.remove('has-mega');
    };

    const open = (id: string) => {
      window.clearTimeout(closeTimer);
      if (triggerFor(id)?.getAttribute('aria-expanded') === 'true') return;
      closeAll();
      triggerFor(id)?.setAttribute('aria-expanded', 'true');
      const panel = panelFor(id);
      if (panel) panel.hidden = false;
      items.find((i) => i.dataset.megaItem === id)?.classList.add('is-open');
      header.classList.add('has-mega');
    };

    const scheduleClose = () => {
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(closeAll, 200);
    };

    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');

    // The label is a link to the page; hovering shows the menu, and the arrow button opens it by keyboard or touch.
    let hoverOpenedAt = 0;
    items.forEach((item) => {
      const id = item.dataset.megaItem!;
      item.addEventListener('mouseenter', () => {
        if (!fine.matches) return;
        if (triggerFor(id)?.getAttribute('aria-expanded') !== 'true') hoverOpenedAt = Date.now();
        open(id);
      });
      item.addEventListener('mouseleave', () => fine.matches && scheduleClose());
    });

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const id = trigger.getAttribute('aria-controls')!;
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        // A click straight after a hover-open keeps the menu open rather than toggling it shut.
        if (isOpen && Date.now() - hoverOpenedAt > 700) closeAll();
        else open(id);
      });
    });

    panels.forEach((panel) => {
      panel.addEventListener('mouseenter', () => window.clearTimeout(closeTimer));
      panel.addEventListener('mouseleave', () => fine.matches && scheduleClose());
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const openTrigger = triggers.find((t) => t.getAttribute('aria-expanded') === 'true');
      if (openTrigger) {
        closeAll();
        openTrigger.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) closeAll();
    });

    // Mobile menu
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const mobile = header.querySelector<HTMLElement>('[data-mobile-nav]');
    const label = toggle?.querySelector<HTMLElement>('.menu-btn__label');
    const setMobile = (isOpen: boolean) => {
      if (!toggle || !mobile) return;
      toggle.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) mobile.style.top = `${header.getBoundingClientRect().bottom}px`;
      mobile.hidden = !isOpen;
      document.documentElement.classList.toggle('menu-open', isOpen);
      if (label) label.textContent = (isOpen ? label.dataset.closeLabel : label.dataset.openLabel) ?? '';
    };
    toggle?.addEventListener('click', () => setMobile(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
        setMobile(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 1080px)').addEventListener('change', (e) => {
      if (e.matches) setMobile(false);
    });

    // Shadow once the page scrolls
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .topbar {
    background: var(--ink);
    color: var(--muted-on-dark);
    font-size: 14px;
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: var(--top-h);
  }

  .topbar__creds {
    display: flex;
    align-items: center;
    gap: 10px;
    letter-spacing: 0.02em;
  }

  .topbar__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 4px rgba(195, 211, 44, 0.2);
  }

  .topbar__right {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .topbar__phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    color: var(--paper);
    text-decoration: none;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .topbar__phone:hover {
    color: var(--saffron-2);
  }

  .lang {
    display: flex;
    gap: 4px;
    padding: 3px;
    border-radius: 999px;
    background: rgba(246, 243, 236, 0.08);
  }

  .lang a {
    padding: 4px 14px;
    border-radius: 999px;
    color: #e2d9ce;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .lang a:hover {
    color: var(--paper);
    background: rgba(246, 243, 236, 0.12);
  }

  .lang a[aria-current] {
    color: var(--white);
    background: var(--saffron);
  }

  @media (max-width: 760px) {
    .topbar__creds {
      display: none;
    }

    .topbar__right {
      width: 100%;
      justify-content: space-between;
      gap: 12px;
    }

    .lang a {
      padding: 3px 10px;
      font-size: 14px;
    }
  }

  @media (max-width: 400px) {
    .topbar__phone {
      font-size: 13px;
      gap: 6px;
    }

    .lang {
      gap: 0;
    }

    .lang a {
      padding: 3px 8px;
      font-size: 13px;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      background-color 0.3s var(--ease);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 10px 30px -24px rgba(29, 22, 18, 0.6);
  }

  .site-header.has-mega {
    background: var(--paper);
    border-bottom-color: var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--header-h);
  }

  .brand {
    display: block;
    flex: none;
  }

  .brand :global(.brand-logo) {
    height: 64px;
    width: auto;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 2px;
    list-style: none;
  }

  .nav__item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 12px 12px;
    color: var(--ink);
    font: 550 16.5px/1 var(--sans);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .nav__item:has(.nav__toggle) .nav__link {
    padding-right: 4px;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 4px;
    height: 2px;
    background: var(--saffron);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }

  .nav__item:has(.nav__toggle) .nav__link::after {
    right: 4px;
  }

  .nav__link:hover,
  .nav__item.is-open .nav__link {
    color: var(--navy);
  }

  .nav__link:hover::after,
  .nav__link[aria-current]::after,
  .nav__item.is-open .nav__link::after {
    transform: scaleX(1);
  }

  .nav__toggle {
    display: grid;
    place-items: center;
    width: 28px;
    height: 36px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  .nav__toggle :global(svg) {
    transition: transform 0.3s var(--ease);
  }

  .nav__toggle[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }

  .bar__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bar__quote {
    min-height: 50px;
    padding: 12px 22px;
    white-space: nowrap;
  }

  .bar__quote-short {
    display: none;
  }

  .menu-btn {
    display: none;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 0 4px 0 12px;
    border: 0;
    background: none;
    color: var(--ink);
    font: 650 17px/1 var(--sans);
    cursor: pointer;
  }

  .menu-btn__icon {
    position: relative;
    width: 24px;
    height: 12px;
  }

  .menu-btn__icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition:
      transform 0.3s var(--ease),
      top 0.3s var(--ease);
  }

  .menu-btn__icon span:first-child {
    top: 0;
  }

  .menu-btn__icon span:last-child {
    top: 10px;
  }

  .menu-btn[aria-expanded='true'] .menu-btn__icon span:first-child {
    top: 5px;
    transform: rotate(45deg);
  }

  .menu-btn[aria-expanded='true'] .menu-btn__icon span:last-child {
    top: 5px;
    transform: rotate(-45deg);
  }

  /* Mega menus */
  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--paper);
    border-bottom: 3px solid var(--saffron);
    box-shadow: 0 40px 80px -40px rgba(29, 26, 24, 0.45);
    animation: mega-in 0.35s var(--ease-out);
  }

  @keyframes mega-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .mega__inner {
    display: grid;
    grid-template-columns: minmax(0, 3.4fr) minmax(0, 8.6fr);
    gap: 48px;
    padding-block: 40px 48px;
  }

  .mega__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .mega__text {
    font-family: var(--serif);
    font-size: 1.75rem;
    line-height: 1.2;
    color: var(--ink);
  }

  .mega__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    list-style: none;
  }

  .mega__grid--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .mega__item {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    padding: 10px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink);
    transition:
      background-color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .mega__item--plain {
    padding-left: 18px;
    border: 1px dashed var(--line-strong);
  }

  .mega__thumb {
    flex: none;
    width: 72px;
    height: 54px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--paper-2);
  }

  .mega__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .mega__label {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .mega__name {
    font-weight: 650;
    font-size: 16px;
    line-height: 1.3;
  }

  .mega__meta {
    font-size: 14px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .mega__item:hover,
  .mega__item[aria-current] {
    background: var(--white);
    transform: translateX(4px);
  }

  .mega__item:hover .mega__name {
    color: var(--navy);
  }

  .mega__item:hover .mega__thumb img {
    transform: scale(1.1);
  }

  /* Mobile navigation */
  .mobile-nav {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--paper);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 1px solid var(--line);
  }

  .mobile-nav__inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: 12px 40px;
    min-height: 100%;
  }

  .mobile-nav__list {
    list-style: none;
  }

  .mobile-nav__list > li {
    border-bottom: 1px solid var(--line);
  }

  .mobile-nav__list summary,
  .mobile-nav__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    font-family: var(--serif);
    font-size: 2rem;
    line-height: 1.1;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
