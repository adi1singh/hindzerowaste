---
// Client logos as two endless rows scrolling in opposite directions (paused on hover).
import { Image } from 'astro:assets';
import { clients } from '../data/clients';

const half = Math.ceil(clients.length / 2);
const rows = [clients.slice(0, half), clients.slice(half)];
---

<div class="clients" aria-label="Clients">
  {
    rows.map((row, r) => (
      <div class:list={['marquee', { 'marquee--reverse': r === 1 }]} style={`--marquee-duration: ${42 + r * 6}s`}>
        <ul class="marquee__track">
          {[0, 1].map((copy) =>
            row.map((c) => (
              <li class:list={['clients__item', { marquee__dup: copy === 1 }]} aria-hidden={copy === 1 ? 'true' : undefined}>
                <Image src={c.logo} alt={copy === 1 ? '' : c.name} height={100} densities={[1, 2]} loading="lazy" />
              </li>
            )),
          )}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .clients {
    display: grid;
    gap: 18px;
  }

  /* Spacing as a right margin (not gap) so the two copies tile seamlessly at -50%. */
  .marquee__track {
    list-style: none;
    padding-block: 6px;
  }

  .clients__item {
    display: grid;
    place-items: center;
    flex: none;
    width: 220px;
    height: 120px;
    margin-right: 18px;
    padding: 8px 14px;
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--line);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }

  .clients__item:hover {
    transform: translateY(-4px) scale(1.04);
    border-color: var(--saffron);
    box-shadow: var(--shadow-md);
  }

  .clients__item img {
    max-height: 100px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  @media (max-width: 600px) {
    .clients__item {
      width: 160px;
      height: 92px;
      padding: 12px 14px;
    }

    .clients__item img {
      max-height: 72px;
    }
  }
</style>
