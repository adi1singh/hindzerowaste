---
// Client logos as two endless rows scrolling in opposite directions (paused on hover).
import { Image } from 'astro:assets';
import { clients } from '../data/clients';

// Size each logo to roughly the same area rather than the same height, so wide
// wordmarks and tall emblems look equally weighted.
const AREA = 9000;
const MAX_H = 80;
const MAX_W = 176;
const fit = (w: number, h: number) => {
  const ratio = w / h;
  let width = Math.sqrt(AREA * ratio);
  let height = width / ratio;
  if (height > MAX_H) [height, width] = [MAX_H, MAX_H * ratio];
  if (width > MAX_W) [width, height] = [MAX_W, MAX_W / ratio];
  return `--w: ${Math.round(width)}px; --h: ${Math.round(height)}px`;
};

const half = Math.ceil(clients.length / 2);
const rows = [clients.slice(0, half), clients.slice(half)];
---

<div class="clients" aria-label="Clients">
  {
    rows.map((row, r) => (
      <div class:list={['marquee', { 'marquee--reverse': r === 1 }]} style={`--marquee-duration: ${42 + r * 6}s`}>
        <ul class="marquee__track">
          {[0, 1].map((copy) =>
            row.map((c) => (
              <li class:list={['clients__item', { marquee__dup: copy === 1 }]} aria-hidden={copy === 1 ? 'true' : undefined}>
                <Image
                  src={c.logo}
                  alt={copy === 1 ? '' : c.name}
                  height={100}
                  densities={[1, 2]}
                  loading="lazy"
                  style={fit(c.logo.width, c.logo.height)}
                />
              </li>
            )),
          )}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .clients {
    display: grid;
    gap: 18px;
  }

  /* Spacing as a right margin (not gap) so the two copies tile seamlessly at -50%. */
  .marquee__track {
    list-style: none;
    padding-block: 6px;
  }

  .clients__item {
    display: grid;
    place-items: center;
    flex: none;
    width: 220px;
    height: 120px;
    margin-right: 18px;
    padding: 8px 14px;
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--line);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }

  .clients__item:hover {
    transform: translateY(-4px) scale(1.04);
    border-color: var(--saffron);
    box-shadow: var(--shadow-md);
  }

  .clients__item {
    --k: 1;
  }

  .clients__item img {
    width: calc(var(--w) * var(--k));
    height: calc(var(--h) * var(--k));
    object-fit: contain;
  }

  @media (max-width: 600px) {
    .clients__item {
      width: 160px;
      height: 92px;
      padding: 12px 14px;
    }

    .clients__item {
      --k: 0.74;
    }
  }
</style>
