---
// Home page "how we work". On desktop the section pins and the four steps ride
// past sideways as you scroll, like stations on a conveyor: a belt underneath
// runs with the scroll and a clay marker carries the step number from station
// to station. Phones and reduced-motion visitors get the cards as a simple list.
import { Image } from 'astro:assets';
import { approachSteps } from '../i18n/content';
import type { Lang } from '../i18n/ui';

import designImg from '../assets/photos/plant-layout-render.jpg';
import buildImg from '../assets/photos/trommel-and-baler.jpg';
import erectImg from '../assets/photos/biomining-conveyor.jpg';
import runImg from '../assets/photos/mrf-sorting-floor.jpg';

interface Props {
  lang?: Lang;
  eyebrow: string;
  title: string;
  intro: string;
}

const { lang = 'en', eyebrow, title, intro } = Astro.props;
const photos = [
  { src: designImg, alt: 'Plant layout drawing for an integrated waste-processing facility' },
  { src: buildImg, alt: 'Trommel drums and a horizontal baler in the Hind Zero Waste workshop' },
  { src: erectImg, alt: 'Discharge conveyor stacking segregated fractions at a bio-mining site' },
  { src: runImg, alt: 'Operators at work on the sorting floor of a material recovery facility' },
];
const steps = approachSteps[lang];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="story on-dark" data-story>
  <div class="story__sticky">
    <div class="story__track" data-track>
      <div class="story__intro">
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="h2 story__title" set:html={title} />
        <p class="story__lead">{intro}</p>
      </div>
      <ol class="story__cards">
        {
          steps.map(([t, text], i) => (
            <li class:list={['story__card', { 'is-active': i === 0 }]} data-card>
              <figure class="story__photo">
                <Image src={photos[i].src} alt={photos[i].alt} widths={[480, 800, 1200]} sizes="(min-width: 1001px) 44vw, 92vw" loading="lazy" />
                <span class="story__num tabular" aria-hidden="true">{pad(i + 1)}</span>
              </figure>
              <div class="story__copy">
                <p class="story__step tabular">{pad(i + 1)} <span>/ {pad(steps.length)}</span></p>
                <h3 class="story__name">{t}</h3>
                <p class="story__text">{text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="story__belt" aria-hidden="true">
      <div class="story__line">
        <span class="story__rollers"></span>
        <span class="story__done"></span>
        <span class="story__marker tabular" data-counter>01</span>
      </div>
      <ol class="story__stations">
        {steps.map(([t], i) => <li data-station style={`--at:${i / (steps.length - 1)}`}>{t}</li>)}
      </ol>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-story]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const counter = root.querySelector<HTMLElement>('[data-counter]')!;
    const stations = [...root.querySelectorAll<HTMLElement>('[data-station]')];
    const pinned = window.matchMedia('(min-width: 1001px) and (prefers-reduced-motion: no-preference)');
    let distance = 0;
    let queued = false;

    const header = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 92;

    const measure = () => {
      if (!pinned.matches) {
        root.style.removeProperty('height');
        track.style.removeProperty('transform');
        return;
      }
      distance = Math.max(0, track.scrollWidth - window.innerWidth);
      // Vertical room equal to the sideways travel, plus one screen to sit on.
      root.style.height = `${distance + window.innerHeight}px`;
      update();
    };

    const update = () => {
      queued = false;
      if (!pinned.matches) return;
      const travel = Math.max(1, root.offsetHeight - (window.innerHeight - header()));
      const p = Math.min(1, Math.max(0, (header() - root.getBoundingClientRect().top) / travel));
      track.style.transform = `translate3d(${(-p * distance).toFixed(1)}px, 0, 0)`;
      root.style.setProperty('--p', p.toFixed(4));
      const mid = window.innerWidth / 2;
      let best = 0;
      let bestGap = Infinity;
      cards.forEach((card, i) => {
        const r = card.getBoundingClientRect();
        const centre = r.left + r.width / 2;
        // Gentle parallax: the photo drifts against the card's movement.
        card.style.setProperty('--shift', ((centre - mid) / window.innerWidth).toFixed(3));
        const gap = Math.abs(centre - mid);
        if (gap < bestGap) {
          bestGap = gap;
          best = i;
        }
      });
      cards.forEach((c, i) => c.classList.toggle('is-active', i === best));
      stations.forEach((st, i) => {
        st.classList.toggle('is-active', i === best);
        st.classList.toggle('is-past', i < best);
      });
      counter.textContent = String(best + 1).padStart(2, '0');
    };

    const request = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', measure);
    pinned.addEventListener('change', measure);
    window.addEventListener('load', measure);
    measure();

    // Phones: each card rises in as it reaches the screen.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -10% 0px' },
      );
      cards.forEach((c) => io.observe(c));
    } else cards.forEach((c) => c.classList.add('is-in'));
  });
</script>

<style>
  .story {
    position: relative;
    isolation: isolate;
    background: #141110;
    color: #e8e0d6;
  }

  .story__sticky {
    position: relative;
    overflow: hidden;
    padding-block: var(--section);
  }

  /* Warm light that drifts across as the story advances. */
  .story__sticky::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: -30%;
    left: -10%;
    width: 60vw;
    height: 60vw;
    background: radial-gradient(circle, rgba(168, 79, 50, 0.28), transparent 62%);
    transform: translateX(calc(var(--p, 0) * 60vw));
    pointer-events: none;
  }

  .story__track {
    display: grid;
    gap: 40px;
    padding-inline: var(--gutter);
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin-inline: auto;
  }

  .story__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .story__title {
    font-size: clamp(2.8rem, 4.8vw, 4.6rem);
    line-height: 1.02;
    color: var(--white);
  }

  .story__title :global(em) {
    color: var(--saffron-2);
  }

  .story__lead {
    max-width: 26em;
    font-size: 17px;
    line-height: 1.65;
    color: var(--muted-on-dark);
  }

  .story__cards {
    display: grid;
    gap: 36px;
    list-style: none;
  }

  .story__photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 6px;
    background: #0d0b0a;
  }

  .story__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story__num {
    position: absolute;
    left: 20px;
    bottom: 10px;
    font: 400 clamp(4rem, 7vw, 6.5rem) / 1 var(--serif);
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.85);
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.35);
  }

  .story__copy {
    padding-top: 22px;
  }

  .story__step {
    font: 700 12px/1 var(--sans);
    letter-spacing: 0.18em;
    color: var(--saffron-2);
  }

  .story__step span {
    color: rgba(246, 243, 236, 0.4);
  }

  .story__name {
    margin-top: 12px;
    font: 600 clamp(1.6rem, 2.3vw, 2.1rem) / 1.12 var(--sans);
    letter-spacing: -0.025em;
    color: var(--white);
  }

  .story__text {
    margin-top: 10px;
    max-width: 30em;
    font-size: 16px;
    line-height: 1.65;
    color: #cfc5ba;
  }

  .story__belt {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .story__card {
      opacity: 0;
      transform: translateY(32px);
      transition:
        opacity 0.7s var(--ease-out),
        transform 0.9s var(--ease-out);
    }

    .story__card.is-in {
      opacity: 1;
      transform: none;
    }
  }

  /* Desktop: pinned, sideways track. */
  @media (min-width: 1001px) and (prefers-reduced-motion: no-preference) {
    .story {
      height: 400vh;
    }

    .story__sticky {
      position: sticky;
      top: var(--header-h);
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: calc(100vh - var(--header-h));
      padding-block: 0;
    }

    .story__track {
      display: flex;
      align-items: center;
      gap: clamp(40px, 4vw, 72px);
      width: max-content;
      max-width: none;
      margin: 0;
      padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2)) 12vw;
      will-change: transform;
    }

    .story__intro {
      flex: none;
      width: min(30vw, 440px);
    }

    .story__cards {
      display: flex;
      gap: clamp(28px, 3vw, 48px);
    }

    .story__card,
    .story__card.is-in {
      flex: none;
      width: min(44vw, calc((100vh - var(--header-h) - 260px) * 4 / 3));
      opacity: 0.45;
      transform: scale(0.94);
      transform-origin: center bottom;
      transition:
        opacity 0.6s var(--ease-out),
        transform 0.8s var(--ease-out);
    }

    .story__card.is-active {
      opacity: 1;
      transform: none;
    }

    .story__photo :global(img) {
      transform: translateX(calc(var(--shift, 0) * -9%)) scale(1.18);
    }

    .story__card.is-active .story__photo {
      box-shadow: 0 50px 90px -40px rgba(0, 0, 0, 0.9);
    }

    .story__copy > * {
      transition:
        opacity 0.6s var(--ease-out),
        transform 0.7s var(--ease-out);
    }

    .story__card:not(.is-active) .story__text {
      opacity: 0;
      transform: translateY(10px);
    }

    /* The belt: rollers that run with the scroll, a clay run that fills
       behind the marker, and four named stations. */
    .story__belt {
      display: block;
      width: min(var(--container), calc(100vw - 2 * var(--gutter)));
      margin: clamp(26px, 4vh, 40px) auto 0;
    }

    .story__line {
      position: relative;
      height: 12px;
      border-radius: 12px;
      background: #26201c;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), inset 0 -2px 4px rgba(0, 0, 0, 0.5);
    }

    .story__rollers {
      position: absolute;
      inset: 3px 6px;
      border-radius: 6px;
      background: repeating-linear-gradient(90deg, rgba(246, 243, 236, 0.16) 0 2px, transparent 2px 14px);
      background-position-x: calc(var(--p, 0) * -900px);
    }

    .story__done {
      position: absolute;
      inset: 0 auto 0 0;
      width: calc(var(--p, 0) * 100%);
      border-radius: 12px;
      background:
        repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.14) 0 2px, transparent 2px 14px),
        linear-gradient(90deg, var(--saffron), var(--saffron-2));
      background-position-x: calc(var(--p, 0) * -900px), 0;
    }

    .story__marker {
      position: absolute;
      top: 50%;
      left: calc(var(--p, 0) * 100%);
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      margin: -20px 0 0 -20px;
      border-radius: 10px;
      background: var(--saffron);
      color: var(--white);
      font: 800 13px/1 var(--sans);
      box-shadow:
        0 0 0 4px #141110,
        0 10px 24px -6px rgba(168, 79, 50, 0.8);
    }

    .story__stations {
      position: relative;
      height: 34px;
      margin-top: 18px;
      list-style: none;
    }

    .story__stations li {
      position: absolute;
      left: calc(var(--at) * 100%);
      top: 0;
      transform: translateX(calc(var(--at) * -100%));
      padding-top: 14px;
      white-space: nowrap;
      font: 600 13px/1 var(--sans);
      letter-spacing: 0.02em;
      color: rgba(246, 243, 236, 0.38);
      transition: color 0.4s var(--ease);
    }

    .story__stations li::before {
      content: '';
      position: absolute;
      top: 0;
      left: calc(var(--at) * 100%);
      width: 8px;
      height: 8px;
      margin-left: calc(var(--at) * -8px);
      border-radius: 50%;
      background: rgba(246, 243, 236, 0.25);
      transition: background-color 0.4s var(--ease), box-shadow 0.4s var(--ease);
    }

    .story__stations li.is-past {
      color: rgba(246, 243, 236, 0.7);
    }

    .story__stations li.is-past::before {
      background: var(--saffron-2);
    }

    .story__stations li.is-active {
      color: var(--white);
    }

    .story__stations li.is-active::before {
      background: var(--saffron-2);
      box-shadow: 0 0 0 4px rgba(224, 138, 98, 0.3);
    }
  }
</style>
