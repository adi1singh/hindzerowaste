---
// Strata footer, on the darkest stratum: company, machinery and service links,
// contact, registered office, legal links and the JobGen.AI partner credit.
import BrandLogo from '../BrandLogo.astro';
import { site, telHref } from '../../data/site';
import { products } from '../../data/products';
import { services } from '../../data/services';
import { localName, localePath, t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
// Partner credit word order differs: 'Powered by X' / 'X द्वारा संचालित' / 'X द्वारे संचालित'.
const powered = { en: ['Powered by ', ''], hi: ['', ' द्वारा संचालित'], mr: ['', ' द्वारे संचालित'] }[lang];
const company = [
  { label: t(lang, 'nav.about'), href: localePath(lang, '/about-us') },
  { label: t(lang, 'nav.projects'), href: localePath(lang, '/about-us') + '#projects' },
  { label: t(lang, 'nav.insights'), href: '/waste-management-blogs' },
  { label: t(lang, 'nav.contact'), href: localePath(lang, '/contact-us') },
];
---

<footer class="sf">
  <div class="wrap">
    <div class="sf__top">
      <div class="sf__brand">
        <a href={localePath(lang, '/')} aria-label={`${site.name}, ${t(lang, 'nav.home')}`}><BrandLogo light /></a>
        <p>{t(lang, 'footer.blurb')}</p>
        <p class="sf__docs">
          <a class="s-link" href={site.downloads.brochure} target="_blank" rel="noopener">{t(lang, 'footer.brochure')}</a>
          <a class="s-link" href={site.downloads.profile} target="_blank" rel="noopener">{t(lang, 'footer.profile')}</a>
        </p>
      </div>
      <nav aria-label={t(lang, 'nav.machinery')}>
        <h2 class="sf__h">{t(lang, 'nav.machinery')}</h2>
        <ul>{products.map((p) => <li><a href={`/${p.slug}`}>{localName(lang, p.slug, p.name)}</a></li>)}</ul>
      </nav>
      <nav aria-label={t(lang, 'nav.services')}>
        <h2 class="sf__h">{t(lang, 'nav.services')}</h2>
        <ul>{services.map((s) => <li><a href={`/${s.slug}`}>{localName(lang, s.slug, s.name)}</a></li>)}</ul>
        <h2 class="sf__h sf__h--gap">{t(lang, 'footer.company')}</h2>
        <ul>{company.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
      </nav>
      <div>
        <h2 class="sf__h">{t(lang, 'footer.contact')}</h2>
        <ul>{site.phones.map((p) => <li><a class="tabular" href={telHref(p)}>{p}</a></li>)}</ul>
        <p class="sf__mail">
          <a href={`mailto:${site.emails.sales}`}>{site.emails.sales}</a>
          <a href={`mailto:${site.emails.info}`}>{site.emails.info}</a>
        </p>
        <h2 class="sf__h sf__h--gap">{t(lang, 'footer.office')}</h2>
        <address>
          {site.address.lines.map((l) => <span>{l}</span>)}
          <span>{site.address.city} {site.address.postcode}, {site.address.region}</span>
        </address>
      </div>
    </div>

    <div class="sf__bottom">
      <p>© {year} {site.name}. {t(lang, 'footer.rights')}</p>
      <ul class="sf__legal">
        <li><a href="/privacy">{t(lang, 'footer.privacy')}</a></li>
        <li><a href="/terms">{t(lang, 'footer.terms')}</a></li>
        {site.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
      </ul>
      <p class="sf__credit">{powered[0]}<a href="https://jobgen.ai/" target="_blank" rel="noopener noreferrer">JobGen.AI</a>{powered[1]}</p>
    </div>
  </div>
</footer>

<style>
  .sf {
    position: relative;
    padding-block: clamp(64px, 8vw, 112px) 36px;
    background: var(--overburden);
    color: var(--chalk);
  }

  .sf__top {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    gap: 40px 48px;
  }

  .sf__brand {
    display: grid;
    align-content: start;
    gap: 20px;
    max-width: 26em;
  }

  .sf__brand :global(.brand-logo) {
    width: 220px;
  }

  .sf__brand > p {
    color: var(--chalk-2);
    font-size: 16px;
  }

  .sf__docs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }

  .sf__h {
    margin-bottom: 14px;
    font-size: 15px;
    font-weight: 700;
    font-stretch: 118%;
    color: var(--chalk);
  }

  .sf__h--gap {
    margin-top: 32px;
  }

  .sf ul {
    display: grid;
    gap: 9px;
  }

  .sf ul a,
  .sf__mail a {
    color: var(--chalk-2);
    text-decoration: none;
    font-size: 15.5px;
  }

  .sf ul a:hover,
  .sf__mail a:hover {
    color: var(--chalk);
    text-decoration: underline;
  }

  .sf__mail {
    display: grid;
    gap: 6px;
    margin-top: 14px;
  }

  address {
    display: grid;
    gap: 2px;
    font-style: normal;
    font-size: 15.5px;
    color: var(--chalk-2);
  }

  .sf__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    margin-top: clamp(48px, 6vw, 80px);
    padding-top: 24px;
    border-top: 1px solid rgba(244, 238, 227, 0.14);
    font-size: 14.5px;
    color: var(--chalk-2);
  }

  .sf__legal {
    display: flex !important;
    flex-wrap: wrap;
    gap: 8px 20px !important;
  }

  .sf__legal a {
    font-size: 14.5px !important;
  }

  .sf__credit a {
    color: var(--chalk);
    font-weight: 750;
    text-decoration: underline;
    text-decoration-color: var(--safety);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 1000px) {
    .sf__top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .sf__top {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
