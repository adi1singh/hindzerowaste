---
// Full first-screen hero for index pages: text on the left, a floating
// three-photo mosaic on the right, and count-up figures underneath.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Count from './Count.astro';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  crumbs?: { label: string; href?: string }[];
  images: { src: ImageMetadata; alt: string }[];
  stats?: { value: number; suffix?: string; label: string }[];
  tone?: 'navy' | 'sky';
}

const { eyebrow, title, lead, crumbs = [], images, stats = [], tone = 'navy' } = Astro.props;
const dark = tone === 'navy';
---

<section class:list={['ihero', `ihero--${tone}`, { 'on-dark': dark }]}>
  <div class="ihero__glow" aria-hidden="true"></div>
  <div class="container ihero__inner">
    <div class="ihero__text">
      {
        crumbs.length > 0 && (
          <nav class="ihero__crumbs" aria-label="Breadcrumb">
            <ol>
              {crumbs.map((c, i) => (
                <li>{c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
              ))}
            </ol>
          </nav>
        )
      }
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h1 class="h1 ihero__title" data-reveal style="--d: 1" set:html={title} />
      <p class="lead ihero__lead" data-reveal style="--d: 2">{lead}</p>
      <div class="btn-row" data-reveal style="--d: 3"><slot /></div>
      {
        stats.length > 0 && (
          <dl class="ihero__stats" data-reveal style="--d: 4">
            {stats.map((s) => (
              <div>
                <dt>
                  <Count value={s.value} suffix={s.suffix} />
                </dt>
                <dd>{s.label}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
    <div class="ihero__mosaic" aria-hidden={images.length ? undefined : 'true'}>
      {
        images.slice(0, 3).map((img, i) => (
          <figure class:list={['ihero__tile', `ihero__tile--${i + 1}`]} data-reveal="zoom" style={`--d:${i + 2}`}>
            <Image
              src={img.src}
              alt={img.alt}
              widths={[400, 640, 900]}
              sizes="(min-width: 1000px) 30vw, 60vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          </figure>
        ))
      }
      <span class="ihero__badge" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .ihero {
    position: relative;
    display: flex;
    min-height: max(600px, calc(100svh - var(--chrome)));
    overflow: hidden;
    isolation: isolate;
  }

  .ihero--navy {
    background: radial-gradient(120% 140% at 0% 0%, var(--navy) 0%, var(--navy-deep) 45%, var(--ink) 100%);
    color: #dfe5ee;
  }

  .ihero--sky {
    background: linear-gradient(160deg, var(--sky) 0%, #f3f7fc 60%, var(--sage) 100%);
  }

  .ihero__glow {
    position: absolute;
    right: -10%;
    bottom: -30%;
    z-index: -1;
    width: 60vw;
    height: 60vw;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(243, 154, 47, 0.28), transparent 62%);
    animation: glow 12s ease-in-out infinite alternate;
  }

  .ihero--sky .ihero__glow {
    background: radial-gradient(circle, rgba(132, 187, 57, 0.3), transparent 62%);
  }

  @keyframes glow {
    to {
      transform: translate(-8%, -6%) scale(1.1);
    }
  }

  .ihero__inner {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5.4fr);
    gap: 48px 64px;
    align-items: center;
    padding-block: clamp(40px, 6vh, 80px);
  }

  .ihero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .ihero__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    font-size: 14px;
    opacity: 0.8;
  }

  .ihero__crumbs li + li::before {
    content: '/';
    margin-right: 6px;
    opacity: 0.6;
  }

  .ihero__crumbs a {
    color: inherit;
    text-decoration: none;
  }

  .ihero__crumbs a:hover {
    text-decoration: underline;
  }

  .ihero--navy .ihero__title {
    color: var(--white);
  }

  .ihero__lead {
    max-width: 34em;
    font-size: 18px;
  }

  .ihero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 40px;
    margin: 16px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line-strong);
  }

  .ihero--navy .ihero__stats {
    border-color: var(--line-on-dark);
  }

  .ihero__stats dt {
    font: 800 clamp(2.2rem, 3.4vw, 3rem) / 1 var(--sans);
    letter-spacing: -0.03em;
    color: var(--navy);
  }

  .ihero--navy .ihero__stats dt {
    color: var(--saffron-2);
  }

  .ihero__stats dd {
    margin: 6px 0 0;
    font-size: 15px;
    opacity: 0.85;
  }

  .ihero__mosaic {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 16px;
    height: min(64vh, 600px);
  }

  .ihero__tile {
    margin: 0;
    overflow: hidden;
    border-radius: 18px;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.55);
    animation: float 7s ease-in-out infinite alternate;
  }

  .ihero__tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .ihero__tile:hover :global(img) {
    transform: scale(1.08);
  }

  .ihero__tile--1 {
    grid-row: 1 / 3;
  }

  .ihero__tile--2 {
    animation-delay: -2.5s;
  }

  .ihero__tile--3 {
    animation-delay: -5s;
  }

  @keyframes float {
    from {
      transform: translateY(-8px);
    }
    to {
      transform: translateY(8px);
    }
  }

  .ihero__badge {
    position: absolute;
    left: -22px;
    bottom: 28px;
    width: 46px;
    height: 46px;
    background: var(--lime);
    box-shadow: 0 58px 0 var(--green);
    opacity: 0.9;
  }

  @media (max-width: 980px) {
    .ihero {
      min-height: auto;
    }

    .ihero__inner {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 40px 56px;
    }

    .ihero__mosaic {
      height: 360px;
    }

    .ihero__badge {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .ihero__mosaic {
      height: 280px;
      gap: 10px;
    }
  }
</style>
