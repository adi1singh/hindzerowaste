---
import { Image } from 'astro:assets';
import type { Product } from '../data/products';
import { localName, type Lang } from '../i18n/ui';
import { categoryName } from '../i18n/content';

interface Props {
  product: Product;
  lang?: Lang;
  index?: number;
}

const { product, lang = 'en', index } = Astro.props;
const cover = product.images[0];
---

<a class="pcard" href={`/${product.slug}`}>
  <div class="pcard__media">
    <Image
      src={cover.src}
      alt={cover.alt}
      widths={[420, 640, 900]}
      sizes="(min-width: 1100px) 400px, (min-width: 700px) 46vw, 92vw"
      loading="lazy"
      style={cover.focus ? `object-position: ${cover.focus}` : undefined}
    />
    {typeof index === 'number' && <span class="pcard__num tabular">{String(index + 1).padStart(2, '0')}</span>}
  </div>
  <div class="pcard__body">
    <p class="pcard__cat">{categoryName(lang, product.category)}</p>
    <h3 class="pcard__name">{localName(lang, product.slug, product.name)}</h3>
    {lang === 'en' && <p class="pcard__short">{product.short}</p>}
    <p class="pcard__range">
      <span class="pcard__chip">{product.range}</span>
      <span class="pcard__go" aria-hidden="true">→</span>
    </p>
  </div>
</a>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--white);
    color: var(--text);
    text-decoration: none;
    box-shadow: 0 1px 0 var(--line);
    transition:
      transform 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
  }

  .pcard::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--saffron), var(--lime));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }

  .pcard:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
  }

  .pcard:hover::after {
    transform: scaleX(1);
  }

  .pcard__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-2);
  }

  .pcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .pcard:hover .pcard__media img {
    transform: scale(1.08);
  }

  .pcard__num {
    position: absolute;
    top: 14px;
    left: 14px;
    display: grid;
    place-items: center;
    min-width: 44px;
    height: 34px;
    padding: 0 10px;
    border-radius: 999px;
    background: rgba(29, 26, 24, 0.72);
    backdrop-filter: blur(6px);
    color: var(--paper);
    font-size: 14px;
    font-weight: 700;
  }

  .pcard__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    padding: 22px 24px 26px;
  }

  .pcard__cat {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-ink);
  }

  /* Machine names in semibold sans: reads as technical and keeps long names on one line. */
  .pcard__name {
    font-family: var(--sans);
    font-weight: 650;
    font-size: clamp(1.2rem, 1.5vw, 1.32rem);
    line-height: 1.25;
    letter-spacing: -0.012em;
    color: var(--ink);
    transition: color 0.3s var(--ease);
  }

  .pcard__short {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .pcard__range {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 12px;
  }

  .pcard__chip {
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--sky);
    color: var(--navy);
    font-size: 14px;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .pcard__go {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    font-size: 18px;
    color: var(--ink);
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease),
      transform 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .pcard:hover .pcard__name {
    color: var(--navy);
  }

  .pcard:hover .pcard__go {
    background: var(--saffron);
    color: var(--white);
    border-color: var(--saffron);
    transform: translateX(4px);
  }
</style>
