---
import { Image } from 'astro:assets';
import type { Product } from '../data/products';
import { localName, type Lang } from '../i18n/ui';

interface Props {
  product: Product;
  lang?: Lang;
  index?: number;
}

const { product, lang = 'en', index } = Astro.props;
const cover = product.images[0];
---

<a class="pcard" href={`/${product.slug}`}>
  <div class="pcard__media frame">
    <Image
      src={cover.src}
      alt={cover.alt}
      widths={[420, 640, 900]}
      sizes="(min-width: 1100px) 400px, (min-width: 700px) 46vw, 92vw"
      loading="lazy"
    />
  </div>
  <div class="pcard__body">
    <p class="pcard__meta">
      {typeof index === 'number' && <span class="tabular">{String(index + 1).padStart(2, '0')}</span>}
      <span>{product.category}</span>
    </p>
    <h3 class="pcard__name">{localName(lang, product.slug, product.name)}</h3>
    {lang === 'en' && <p class="pcard__short">{product.short}</p>}
    <p class="pcard__range"><span>{product.range}</span><span class="arrow" aria-hidden="true">→</span></p>
  </div>
</a>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .pcard__media {
    aspect-ratio: 4 / 3;
  }

  .pcard__media img {
    transition: transform 1.1s var(--ease);
  }

  .pcard:hover .pcard__media img {
    transform: scale(1.04);
  }

  .pcard__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    padding-top: 22px;
  }

  .pcard__meta {
    display: flex;
    gap: 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pcard__name {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.2vw, 1.95rem);
    line-height: 1.1;
    color: var(--ink);
  }

  .pcard__short {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }

  .pcard__range {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .pcard__range .arrow {
    transition: transform 0.3s var(--ease);
  }

  .pcard:hover .pcard__range .arrow {
    transform: translateX(4px);
  }

  .pcard:hover .pcard__name {
    color: var(--navy);
  }
</style>
