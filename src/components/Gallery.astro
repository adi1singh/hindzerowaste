---
import { Image } from 'astro:assets';
import type { Photo } from '../data/products';

interface Props {
  images: Photo[];
  priority?: boolean;
}

const { images, priority = false } = Astro.props;
---

<div class="gallery" data-gallery>
  <div class="gallery__stage frame">
    {
      images.map((img, i) => (
        <Image
          src={img.src}
          alt={img.alt}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1100px) 620px, 92vw"
          loading={i === 0 && priority ? 'eager' : 'lazy'}
          fetchpriority={i === 0 && priority ? 'high' : undefined}
          class:list={['gallery__img', { 'is-active': i === 0 }]}
          data-index={i}
        />
      ))
    }
  </div>
  {
    images.length > 1 && (
      <div class="gallery__thumbs" role="group" aria-label="Photos">
        {images.map((img, i) => (
          <button type="button" class="gallery__thumb frame" aria-pressed={i === 0 ? 'true' : 'false'} data-thumb={i}>
            <Image src={img.src} alt="" width={160} height={120} loading="lazy" />
            <span class="visually-hidden">{`Show photo ${i + 1}: ${img.alt}`}</span>
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const imgs = gallery.querySelectorAll<HTMLElement>('.gallery__img');
    const thumbs = gallery.querySelectorAll<HTMLButtonElement>('[data-thumb]');
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const index = thumb.dataset.thumb;
        imgs.forEach((img) => img.classList.toggle('is-active', img.dataset.index === index));
        thumbs.forEach((t) => t.setAttribute('aria-pressed', String(t === thumb)));
      });
    });
  });
</script>

<style>
  .gallery__stage {
    position: relative;
    aspect-ratio: 4 / 3;
  }

  .gallery__stage :global(.gallery__img) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }

  .gallery__stage :global(.gallery__img.is-active) {
    opacity: 1;
  }

  .gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-top: 10px;
  }

  .gallery__thumb {
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 0;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.25s var(--ease);
    outline-offset: 2px;
  }

  .gallery__thumb:hover,
  .gallery__thumb[aria-pressed='true'] {
    opacity: 1;
  }

  .gallery__thumb[aria-pressed='true'] {
    box-shadow: inset 0 -3px 0 var(--navy);
  }
</style>
