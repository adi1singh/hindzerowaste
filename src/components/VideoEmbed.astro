---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  poster: ImageMetadata;
}

const { id, title, poster } = Astro.props;
---

<div class="video frame" data-video={id} data-title={title}>
  <Image src={poster} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1100px) 1000px, 92vw" loading="lazy" />
  <button type="button" class="video__play" aria-label={`Play video: ${title}`}>
    <span class="video__icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
    </span>
    <span class="video__label">{title}</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.video}?autoplay=1&rel=0`;
      iframe.title = el.dataset.title ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    });
  });
</script>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--ink);
  }

  .video :global(img) {
    opacity: 0.72;
  }

  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video__play {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    border: 0;
    background: linear-gradient(180deg, rgba(12, 22, 38, 0.1), rgba(12, 22, 38, 0.55));
    color: var(--paper);
    cursor: pointer;
  }

  .video__icon {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    transition: transform 0.35s var(--ease);
  }

  .video__play:hover .video__icon {
    transform: scale(1.06);
  }

  .video__label {
    font: 600 14px/1.3 var(--sans);
    letter-spacing: 0.04em;
  }
</style>
