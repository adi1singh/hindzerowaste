---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details>
        <summary>
          <span>{item.q}</span>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--line-strong);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 0;
    font-family: var(--serif);
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    line-height: 1.2;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.3s var(--ease);
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  details[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  details p {
    padding: 0 0 26px;
    max-width: 46em;
    color: var(--muted);
  }
</style>
