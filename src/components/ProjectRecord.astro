---
import Count from './Count.astro';
import Icon from './Icon.astro';
import { completedBiomining, ongoingBiomining, plantProjects } from '../data/projects';
const clearedTotal = completedBiomining.reduce((total, project) => total + Number(project.volume.replace(/[^\d]/g, '')), 0);
const groups = [
  { id: 'completed', count: completedBiomining.length, label: 'Completed bio-mining projects', short: 'Completed', detail: `${clearedTotal.toLocaleString('en-IN')} m³ of legacy waste cleared`, rows: completedBiomining },
  { id: 'ongoing', count: ongoingBiomining.length, label: 'Bio-mining projects in progress', short: 'In progress', detail: 'Maharashtra, Himachal Pradesh and Telangana', rows: ongoingBiomining },
  { id: 'plants', count: plantProjects.length, label: 'Processing plant & O&M projects', short: 'Plants & O&M', detail: 'Rajasthan, Delhi and Telangana', rows: plantProjects.map(site => ({ site, volume: '', note: '' })) },
];
---

<section class="section record" aria-labelledby="record-title" data-project-record>
  <div class="container">
    <div class="record__heading" data-reveal>
      <div>
        <p class="eyebrow">Our project record</p>
        <h2 class="record__title" id="record-title">Real projects.<br /><em>Real progress.</em></h2>
      </div>
      <p class="record__intro">From reclaimed dumpsites to working plants. Explore the projects behind the numbers.</p>
    </div>
    <div class="record__tabs" aria-label="Project categories" data-record-tabs>
      {groups.map((group, i) => (
        <a class={`record__tab record__tab--${group.id}`} id={`record-tab-${group.id}`} href={`#record-panel-${group.id}`} data-record-tab={group.id} data-reveal style={`--d:${i}`}>
          <span class="record__tab-top"><span class="record__tag">{group.short}</span><span class="record__tab-arrow" aria-hidden="true">↓</span></span>
          <span class="record__count"><Count value={group.count} /></span>
          <span class="record__label">{group.label}</span>
          <span class="record__tab-rule" aria-hidden="true"></span>
        </a>
      ))}
    </div>
    {groups.map(group => (
      <section class={`record__panel record__panel--${group.id}`} id={`record-panel-${group.id}`} aria-labelledby={`record-heading-${group.id}`} data-record-panel={group.id}>
        <header class="record__panel-head">
          <div><h3 id={`record-heading-${group.id}`}>{group.label}</h3><p>{group.detail}</p></div>
          <span class="record__total">{group.rows.length} projects</span>
        </header>
        <div class="record__panel-layout">
          <aside class="record__summary">
            <span class="record__summary-mark" aria-hidden="true"><Icon name={group.id === 'completed' ? 'biomining' : group.id === 'ongoing' ? 'operate' : 'factory'} size={48} /></span>
            <p class="record__summary-value tabular">{group.id === 'completed' ? clearedTotal.toLocaleString('en-IN') : group.count}<span>{group.id === 'completed' ? 'm³' : 'projects'}</span></p>
            <p class="record__summary-label">{group.id === 'completed' ? 'Legacy waste cleared' : group.id === 'ongoing' ? 'Bio-mining in progress' : 'Processing plants & O&M'}</p>
            <span class="record__summary-rule" aria-hidden="true"></span>
            <p class="record__summary-caption">{group.id === 'completed' ? `${group.count} completed bio-mining projects.` : group.detail}</p>
          </aside>
          <ol class="record__list">
          {group.rows.map((project, i) => (
            <li class="record__project">
              <div class="record__project-top"><span class="record__index tabular" aria-hidden="true">PROJECT {String(i + 1).padStart(2, '0')}</span><span class="record__project-state">{group.short}</span></div>
              <div class="record__site"><h4>{project.site}</h4>{project.note && <span class="record__note">{project.note}</span>}</div>
              {project.volume && <p class="record__volume tabular"><strong>{project.volume.match(/^[\d,]+/)?.[0]}</strong><span>{project.volume.replace(/^[\d,]+\s*/, '')}</span></p>}
            </li>
          ))}
        </ol>
        </div>
      </section>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-project-record]').forEach(root => {
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[data-record-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-record-panel]')];
    const tablist = root.querySelector<HTMLElement>('[data-record-tabs]');
    if (!tablist || !tabs.length || tabs.length !== panels.length) return;
    root.classList.add('is-enhanced');
    tablist.setAttribute('role', 'tablist');
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-controls', panels[i].id);
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].setAttribute('role', 'tabpanel');
        panels[i].setAttribute('aria-labelledby', tab.id);
        panels[i].tabIndex = 0;
        panels[i].hidden = i !== index;
      });
      if (focus) tabs[index].focus();
    };
    const initial = panels.findIndex(panel => `#${panel.id}` === window.location.hash);
    select(initial < 0 ? 0 : initial);
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', event => {
        event.preventDefault();
        select(index);
      });
      tab.addEventListener('keydown', event => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(next, true);
      });
    });
    window.addEventListener('hashchange', () => {
      const index = panels.findIndex(panel => `#${panel.id}` === window.location.hash);
      if (index >= 0) select(index);
    });
  });
</script>

<style>
  .record { background: var(--paper); }
  .record__heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; margin-bottom: 48px; }
  .record__title { margin-top: 18px; font: 400 clamp(3rem, 6vw, 5.4rem)/.98 var(--serif); letter-spacing: -.04em; color: var(--ink); }
  .record__title em { color: var(--saffron); font-weight: 400; }
  .record__intro { max-width: 24em; margin-bottom: 5px; color: var(--muted); font-size: 17px; line-height: 1.7; }
  .record__tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-bottom: 32px; }
  .record__tab {
    --record-accent: var(--green-ink);
    display: flex; flex-direction: column; position: relative;
    padding: 24px 28px 26px; border: 1px solid var(--line-strong); border-radius: 14px;
    text-decoration: none; color: var(--ink); background: color-mix(in srgb, var(--white) 62%, var(--paper));
    overflow: hidden; transition: background-color .3s var(--ease), color .3s var(--ease), box-shadow .3s var(--ease);
  }
  .record__tab--ongoing { --record-accent: var(--saffron); }
  .record__tab--plants { --record-accent: var(--navy); }
  .record__tab:hover { background: var(--white); box-shadow: var(--shadow-md); }
  .record__tab:focus-visible { outline: 3px solid var(--saffron); outline-offset: 4px; }
  .record__tab-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .record__tag { display: flex; align-items: center; gap: 8px; font: 650 12px/1.4 var(--sans); letter-spacing: .08em; text-transform: uppercase; }
  .record__tag::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--record-accent); }
  .record__tab-arrow { font-size: 23px; line-height: 1; color: var(--record-accent); }
  .record__count { margin-block: 20px 10px; font: 650 clamp(4rem, 7vw, 6.3rem)/1 var(--sans); letter-spacing: -.07em; color: var(--record-accent); }
  .record__label { font-size: 16px; font-weight: 550; line-height: 1.45; max-width: 20em; }
  .record__tab-rule { position: absolute; inset: auto 0 0; height: 4px; background: var(--record-accent); transform: scaleX(.18); transform-origin: left; transition: transform .4s var(--ease); }
  .record__tab[aria-selected='true'] { background: color-mix(in srgb, var(--record-accent) 13%, var(--white)); color: var(--ink); border-color: var(--record-accent); box-shadow: 0 6px 20px -16px var(--record-accent); }
  .record__tab[aria-selected='true'] .record__count, .record__tab[aria-selected='true'] .record__tab-arrow { color: var(--record-accent); }
  .record__tab[aria-selected='true'] .record__tag::before { background: currentColor; }
  .record__tab[aria-selected='true'] .record__tab-rule { background: var(--record-accent); transform: scaleX(1); }
  .record__panel { background: #f9f7f2; border: 1px solid var(--line); border-radius: 20px; overflow: clip; scroll-margin-top: calc(var(--header-h) + 30px); }
  .record__panel[hidden] { display: none; }
  .record__panel + .record__panel { margin-top: 24px; }
  .is-enhanced .record__panel + .record__panel { margin-top: 0; }
  .record__panel-head { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 28px 32px; border-bottom: 1px solid var(--line); background: var(--white); }
  .record__panel-head h3 { font: 700 23px/1.3 var(--sans); letter-spacing: -.03em; }
  .record__panel-head p { margin-top: 8px; color: var(--muted); font-size: 15px; }
  .record__total { font-size: 12px; font-weight: 650; padding: 8px 14px; background: var(--sage); color: var(--green-ink); border-radius: 30px; white-space: nowrap; }
  .record__panel-layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 28px; padding: 30px; align-items: start; }
  .record__summary { position: sticky; top: calc(var(--header-h) + 24px); padding: 30px 24px; border-radius: 14px; background: var(--sage); }
  .record__summary-mark { display: inline-flex; margin-bottom: 38px; color: var(--green-ink); }
  .record__summary-value { font: 750 clamp(2.2rem, 3.2vw, 3rem)/1 var(--sans); letter-spacing: -.065em; color: var(--ink); }
  .record__summary-value > span { display: block; margin-top: 8px; font-size: 18px; letter-spacing: -.01em; font-weight: 550; color: var(--green-ink); }
  .record__summary-label { margin-top: 20px; font: 650 18px/1.4 var(--sans); color: var(--ink); }
  .record__summary-rule { display: block; width: 36px; height: 2px; margin-block: 28px 18px; background: var(--green-ink); }
  .record__summary-caption { font-size: 13px; line-height: 1.7; color: var(--muted); }
  .record__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; list-style: none; }
  .record__project { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; padding: 22px; border: 1px solid var(--line); border-radius: 13px; background: var(--white); }
  .record__project:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .record__project-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; width: 100%; }
  .record__index { font: 650 10px/1.4 var(--sans); letter-spacing: .1em; color: var(--muted); }
  .record__project-state { display: inline-flex; align-items: center; gap: 5px; font-size: 10px; font-weight: 600; color: var(--green-ink); }
  .record__project-state::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .record__site h4 { font: 650 17px/1.4 var(--sans); letter-spacing: -.025em; color: var(--ink); }
  .record__note { display: block; margin-top: 8px; font-size: 12px; line-height: 1.5; color: var(--muted); }
  .record__volume { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 16px; border-top: 1px solid var(--line); width: 100%; color: var(--green-ink); }
  .record__volume strong { font: 700 clamp(1.6rem, 2.4vw, 2.1rem)/1.15 var(--sans); letter-spacing: -.05em; }
  .record__volume > span { font-size: 13px; font-weight: 550; }
  .record__panel--ongoing .record__summary { background: var(--sky); }
  .record__panel--ongoing .record__volume, .record__panel--ongoing .record__project-state { color: var(--saffron-ink); }
  .record__panel--plants .record__summary { background: var(--mineral); }
  .record__panel--plants .record__project-state { color: #365c68; }
  @media (prefers-reduced-motion: no-preference) {
    .is-enhanced .record__panel:not([hidden]) .record__list { animation: record-in .4s var(--ease-out) both; }
    .record__project { transition: transform .3s var(--ease), border-color .3s var(--ease), box-shadow .3s var(--ease); }
    .record__project:hover { transform: translateY(-3px); border-color: #a7ba93; box-shadow: 0 12px 24px -20px rgba(var(--shade), .4); }
  }
  @keyframes record-in { from { opacity: .25; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (max-width: 1000px) {
    .record__heading { align-items: flex-start; flex-direction: column; gap: 24px; }
    .record__intro { max-width: 35em; }
    .record__panel-layout { grid-template-columns: minmax(0, 1fr); padding: 24px; }
    .record__summary { position: static; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 12px 32px; padding: 24px; }
    .record__summary-mark, .record__summary-rule { display: none; }
    .record__summary-label { margin-top: 0; }
    .record__summary-value { grid-row: span 2; }
    .record__summary-caption { grid-column: 2; }
    .record__tab { padding: 22px 20px; }
  }
  @media (max-width: 600px) {
    .record__heading { margin-bottom: 32px; }
    .record__tabs { gap: 8px; margin-bottom: 20px; }
    .record__tab { padding: 15px 12px 18px; border-radius: 10px; }
    .record__tag { font-size: 9px; letter-spacing: 0; gap: 5px; }
    .record__tag::before { width: 4px; height: 4px; flex: none; }
    .record__tab-arrow { display: none; }
    .record__count { font-size: 48px; margin-block: 16px 8px; }
    .record__label { font-size: 11px; font-weight: 600; line-height: 1.5; }
    .record__panel-head { padding: 22px; }
    .record__panel-head h3 { font-size: 19px; }
    .record__panel-head p { font-size: 13px; }
    .record__total { display: none; }
    .record__panel-layout { padding: 14px; gap: 14px; }
    .record__summary { padding: 20px; gap: 10px 20px; }
    .record__summary-value { font-size: 32px; }
    .record__summary-value > span { font-size: 14px; }
    .record__summary-label { font-size: 15px; }
    .record__summary-caption { font-size: 11px; }
    .record__list { grid-template-columns: minmax(0, 1fr); }
    .record__project { padding: 22px; }
  }
  @media (max-width: 380px) {
    .record__summary { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .record__summary-value { grid-row: auto; display: flex; align-items: baseline; gap: 8px; }
    .record__summary-value > span { margin: 0; }
    .record__summary-caption { display: none; }
  }
</style>
