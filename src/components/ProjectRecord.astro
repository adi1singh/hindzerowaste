---
// About page project record (English): the headline volume cleared, then a
// sliding switch between completed bio-mining (a ranked bar list), bio-mining in
// progress (cards, with real progress where the data has it) and processing
// plant / O&M projects (capacity-first cards).
import Count from './Count.astro';
import { completedBiomining, ongoingBiomining, plantProjects } from '../data/projects';

const volume = (v: string) => Number(v.replace(/[^\d]/g, ''));
const completed = [...completedBiomining].sort((a, b) => volume(b.volume) - volume(a.volume));
const clearedTotal = completed.reduce((t, p) => t + volume(p.volume), 0);
const maxVolume = volume(completed[0].volume);

// Where an ongoing project states how much is done (e.g. "7,02,900 m³ completed"
// of an 8,00,000 m³ scope), show it as a progress bar.
const ongoing = ongoingBiomining.map((p) => {
  const done = p.note?.match(/^([\d,]+)\s*m³ completed/);
  const pct = done && p.volume.includes('m³') ? Math.round((volume(done[1]) / volume(p.volume)) * 100) : null;
  return { ...p, pct };
});

// Lead each plant project with its capacity, e.g. "100 TPD" or "Two 300 TPD".
const plants = plantProjects.map((text) => {
  const m = text.match(/^((?:Two )?\d+ TPD)\s*/);
  const lead = m ? m[1] : text.split(':')[0];
  const rest = (m ? text.slice(m[0].length) : text.slice(lead.length + 1)).trim();
  return { lead, rest: rest.charAt(0).toUpperCase() + rest.slice(1) };
});

const groups = [
  { id: 'completed', count: completed.length, label: 'Completed bio-mining', detail: `${clearedTotal.toLocaleString('en-IN')} m³ of legacy waste cleared` },
  { id: 'ongoing', count: ongoing.length, label: 'Bio-mining in progress', detail: 'Maharashtra, Himachal Pradesh and Telangana' },
  { id: 'plants', count: plants.length, label: 'Plants & O&M', detail: 'Processing plants and long-term operation in Rajasthan, Delhi and Telangana' },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="section record" aria-labelledby="record-title" data-project-record>
  <div class="container">
    <div class="record__heading" data-reveal>
      <div>
        <p class="eyebrow">Our project record</p>
        <h2 class="record__title" id="record-title">Real projects.<br /><em>Real progress.</em></h2>
      </div>
      <div class="record__hero">
        <p class="record__hero-num tabular"><Count value={clearedTotal} format="en-IN" /><span>m³</span></p>
        <p class="record__hero-label">of legacy waste cleared across {completed.length} completed bio-mining projects.</p>
      </div>
    </div>

    <div class="record__switch" aria-label="Project categories" data-record-tabs style="--sel:0">
      <span class="record__pill" aria-hidden="true"></span>
      {
        groups.map((g) => (
          <a class="record__tab" id={`record-tab-${g.id}`} href={`#record-panel-${g.id}`} data-record-tab={g.id}>
            <span class="record__tab-count tabular">{g.count}</span>
            <span class="record__tab-label">{g.label}</span>
          </a>
        ))
      }
    </div>

    <section class="record__panel" id="record-panel-completed" aria-labelledby="record-h-completed" data-record-panel="completed">
      <header class="record__panel-head">
        <h3 id="record-h-completed">Completed bio-mining projects</h3>
        <p>{groups[0].detail}, largest first.</p>
      </header>
      <ol class="record__rank">
        {
          completed.map((p, i) => (
            <li class="record__row" style={`--k:${i}`}>
              <span class="record__idx tabular">{pad(i + 1)}</span>
              <span class="record__site">
                {p.site}
                {p.note && <small>{p.note}</small>}
              </span>
              <span class="record__track" aria-hidden="true">
                <i style={`--w:${(volume(p.volume) / maxVolume).toFixed(4)}`} />
              </span>
              <span class="record__vol tabular">{p.volume}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="record__panel" id="record-panel-ongoing" aria-labelledby="record-h-ongoing" data-record-panel="ongoing">
      <header class="record__panel-head">
        <h3 id="record-h-ongoing">Bio-mining projects in progress</h3>
        <p>{groups[1].detail}.</p>
      </header>
      <ul class="record__live">
        {
          ongoing.map((p, i) => (
            <li class="record__card" style={`--k:${i}`}>
              <span class="record__status">
                <span class="record__pulse" aria-hidden="true" />
                In progress
              </span>
              <p class="record__card-vol tabular">{p.volume}</p>
              <p class="record__card-site">{p.site}</p>
              {p.pct !== null ? (
                <div class="record__progress">
                  <span class="record__progress-track" aria-hidden="true">
                    <i style={`--w:${(p.pct / 100).toFixed(3)}`} />
                  </span>
                  <span class="record__progress-text tabular">
                    {p.note} <b>· {p.pct}%</b>
                  </span>
                </div>
              ) : (
                p.note && <p class="record__card-note">{p.note}</p>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="record__panel" id="record-panel-plants" aria-labelledby="record-h-plants" data-record-panel="plants">
      <header class="record__panel-head">
        <h3 id="record-h-plants">Processing plant and O&amp;M projects</h3>
        <p>{groups[2].detail}.</p>
      </header>
      <ul class="record__plants">
        {
          plants.map((p, i) => (
            <li class="record__plant" style={`--k:${i}`}>
              <span class="record__plant-no tabular">{pad(i + 1)}</span>
              <p class="record__plant-lead">{p.lead}</p>
              <p class="record__plant-text">{p.rest}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-project-record]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[data-record-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-record-panel]')];
    const tablist = root.querySelector<HTMLElement>('[data-record-tabs]');
    if (!tablist || !tabs.length || tabs.length !== panels.length) return;
    root.classList.add('is-enhanced');
    tablist.setAttribute('role', 'tablist');
    const select = (index: number, focus = false) => {
      tablist.style.setProperty('--sel', String(index));
      tabs.forEach((tab, i) => {
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-controls', panels[i].id);
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].setAttribute('role', 'tabpanel');
        panels[i].setAttribute('aria-labelledby', tab.id);
        panels[i].tabIndex = 0;
        panels[i].hidden = i !== index;
      });
      if (focus) tabs[index].focus();
    };
    const initial = panels.findIndex((panel) => `#${panel.id}` === window.location.hash);
    select(initial < 0 ? 0 : initial);
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        select(index);
      });
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(next, true);
      });
    });
    window.addEventListener('hashchange', () => {
      const index = panels.findIndex((panel) => `#${panel.id}` === window.location.hash);
      if (index >= 0) select(index);
    });

    // Bars grow once the section scrolls into view.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            root.classList.add('is-in');
            io.disconnect();
          }
        },
        { threshold: 0.2 },
      );
      io.observe(root);
    } else root.classList.add('is-in');
  });
</script>

<style>
  .record {
    background: #ebe0cf;
  }

  /* Heading with the headline figure */
  .record__heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: clamp(36px, 4vw, 52px);
  }

  .record__title {
    margin-top: 18px;
    font: 400 clamp(3rem, 6vw, 5.4rem) / 0.98 var(--serif);
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .record__title em {
    color: var(--saffron);
  }

  .record__hero {
    max-width: 24em;
    text-align: right;
  }

  .record__hero-num {
    font: 800 clamp(3rem, 5.6vw, 5rem) / 1 var(--sans);
    letter-spacing: -0.045em;
    color: var(--saffron-ink);
  }

  .record__hero-num span {
    margin-left: 6px;
    font-size: 0.42em;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--ink);
  }

  .record__hero-label {
    margin-top: 10px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Sliding switch */
  .record__switch {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: 22px;
    padding: 6px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--line);
  }

  .record__pill {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 6px;
    width: calc((100% - 12px) / 3);
    border-radius: 13px;
    background: var(--ink);
    box-shadow: 0 14px 30px -18px rgba(var(--shade), 0.8);
    transform: translateX(calc(var(--sel, 0) * 100%));
    transition: transform 0.5s var(--ease-out);
  }

  .record__tab {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    border-radius: 13px;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.35s var(--ease);
  }

  .record__tab-count {
    font: 800 clamp(2rem, 3vw, 2.6rem) / 1 var(--sans);
    letter-spacing: -0.04em;
    color: var(--saffron);
    transition: color 0.35s var(--ease);
  }

  .record__tab-label {
    font: 650 15px/1.3 var(--sans);
  }

  .record__tab[aria-selected='true'] {
    color: var(--white);
  }

  .record__tab[aria-selected='true'] .record__tab-count {
    color: var(--saffron-2);
  }

  .record__tab:not([aria-selected='true']):hover {
    background: rgba(255, 255, 255, 0.6);
  }

  .record__tab:focus-visible {
    outline: 3px solid var(--saffron);
    outline-offset: 2px;
  }

  /* Panels */
  .record__panel {
    padding: clamp(22px, 3vw, 36px);
    border-radius: 20px;
    background: var(--white);
    box-shadow: 0 30px 60px -45px rgba(var(--shade), 0.5);
    scroll-margin-top: calc(var(--header-h) + 30px);
  }

  .record__panel[hidden] {
    display: none;
  }

  .record__panel + .record__panel {
    margin-top: 22px;
  }

  .is-enhanced .record__panel + .record__panel {
    margin-top: 0;
  }

  .record__panel-head {
    margin-bottom: 22px;
  }

  .record__panel-head h3 {
    font: 750 clamp(1.3rem, 1.9vw, 1.6rem) / 1.25 var(--sans);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .record__panel-head p {
    margin-top: 6px;
    font-size: 15px;
    color: var(--muted);
  }

  /* Completed: ranked bar list */
  .record__rank {
    display: grid;
    list-style: none;
  }

  .record__row {
    display: grid;
    grid-template-columns: 34px minmax(0, 1.1fr) minmax(0, 1.4fr) 116px;
    gap: 16px;
    align-items: center;
    padding: 12px 10px;
    border-top: 1px solid var(--line);
    border-radius: 8px;
    transition: background-color 0.25s var(--ease);
  }

  .record__row:hover {
    background: #f7efe6;
  }

  .record__idx {
    font: 700 13px/1 var(--sans);
    color: var(--muted);
  }

  .record__site {
    font: 600 16px/1.35 var(--sans);
    color: var(--ink);
  }

  .record__site small {
    display: block;
    margin-top: 3px;
    font-size: 13px;
    font-weight: 450;
    color: var(--muted);
  }

  .record__track {
    height: 14px;
    border-radius: 0 4px 4px 0;
    background: #f2eae0;
  }

  .record__track i {
    display: block;
    height: 100%;
    width: calc(var(--w) * 100%);
    min-width: 4px;
    border-radius: 0 4px 4px 0;
    background: linear-gradient(90deg, var(--saffron), #c9714c);
    transform-origin: left;
  }

  .record__row:hover .record__track i {
    background: var(--ink);
  }

  .record__vol {
    font: 750 17px/1 var(--sans);
    letter-spacing: -0.02em;
    text-align: right;
    color: var(--saffron-ink);
  }

  /* In progress: cards */
  .record__live {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
  }

  .record__card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    border-radius: 14px;
    background: #faf5ee;
    border: 1px solid var(--line);
  }

  .record__status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    margin-bottom: 8px;
    padding: 6px 12px 6px 10px;
    border-radius: 999px;
    background: #f6e3d6;
    font: 700 12px/1 var(--sans);
    letter-spacing: 0.04em;
    color: var(--saffron-ink);
  }

  .record__pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--saffron);
  }

  .record__card-vol {
    font: 800 clamp(1.9rem, 2.8vw, 2.5rem) / 1.05 var(--sans);
    letter-spacing: -0.035em;
    color: var(--saffron-ink);
  }

  .record__card-site {
    font: 600 16px/1.4 var(--sans);
    color: var(--ink);
  }

  .record__card-note {
    font-size: 14px;
    color: var(--muted);
  }

  .record__progress {
    display: grid;
    gap: 8px;
    margin-top: 8px;
  }

  .record__progress-track {
    height: 10px;
    border-radius: 4px;
    background: #ecdccd;
    overflow: hidden;
  }

  .record__progress-track i {
    display: block;
    height: 100%;
    width: calc(var(--w) * 100%);
    border-radius: 0 4px 4px 0;
    background: linear-gradient(90deg, var(--saffron), #c9714c);
    transform-origin: left;
  }

  .record__progress-text {
    font-size: 14px;
    color: var(--muted);
  }

  .record__progress-text b {
    color: var(--saffron-ink);
  }

  /* Plants & O&M */
  .record__plants {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
  }

  .record__plant {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 22px;
    border-radius: 14px;
    background: #faf5ee;
    border: 1px solid var(--line);
    border-top: 3px solid var(--green-ink);
  }

  .record__plant-no {
    font: 700 12px/1 var(--sans);
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .record__plant-lead {
    font: 800 clamp(1.5rem, 2.2vw, 1.9rem) / 1.1 var(--sans);
    letter-spacing: -0.03em;
    color: var(--green-ink);
  }

  .record__plant-text {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
  }

  /* Motion */
  @media (prefers-reduced-motion: no-preference) {
    .is-in .record__panel:not([hidden]) .record__track i,
    .is-in .record__panel:not([hidden]) .record__progress-track i {
      animation: record-grow 1s var(--ease-out) both;
      animation-delay: calc(var(--k, 0) * 50ms + 150ms);
    }

    .is-enhanced .record__panel:not([hidden]) :is(.record__row, .record__card, .record__plant) {
      animation: record-rise 0.55s var(--ease-out) both;
      animation-delay: calc(var(--k, 0) * 35ms);
    }

    .record__pulse::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--saffron);
      animation: record-pulse 1.8s ease-out infinite;
    }

    .record__card,
    .record__plant {
      transition:
        transform 0.35s var(--ease-out),
        box-shadow 0.35s var(--ease-out);
    }

    .record__card:hover,
    .record__plant:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 36px -26px rgba(var(--shade), 0.5);
    }
  }

  @keyframes record-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes record-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes record-pulse {
    to {
      transform: scale(2.8);
      opacity: 0;
    }
  }

  @media (max-width: 1000px) {
    .record__heading {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .record__hero {
      text-align: left;
    }

    .record__plants {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .record__tab {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding: 12px;
    }

    .record__tab-label {
      font-size: 12.5px;
    }

    .record__row {
      grid-template-columns: 28px minmax(0, 1fr) auto;
      grid-template-areas: 'idx site vol' 'idx track track';
      gap: 8px 12px;
      padding: 14px 4px;
    }

    .record__idx {
      grid-area: idx;
      align-self: start;
      padding-top: 2px;
    }

    .record__site {
      grid-area: site;
    }

    .record__vol {
      grid-area: vol;
      align-self: start;
      font-size: 15px;
    }

    .record__track {
      grid-area: track;
      height: 10px;
    }

    .record__live,
    .record__plants {
      grid-template-columns: minmax(0, 1fr);
    }

  }
</style>
